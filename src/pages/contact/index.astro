---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { asText, withBase } from "../../components/content";
import site from "../../data/site.json";

const siteData = site as Record<string, unknown>;
const siteName = asText(siteData.shortName ?? siteData.name, "Research Lab");
const university = asText(siteData.university);
const address = Array.isArray(siteData.address)
  ? siteData.address.filter(
      (line): line is string =>
        typeof line === "string" && line.trim().length > 0,
    )
  : [];
const location = [university, ...address].filter(Boolean);
const email = asText(siteData.email).trim();
const phone = asText(siteData.phone).trim();
const socials = Array.isArray(siteData.socials)
  ? siteData.socials.filter(
      (social): social is { label: string; url: string } =>
        Boolean(social) &&
        typeof social === "object" &&
        typeof social.label === "string" &&
        social.label.trim().length > 0 &&
        typeof social.url === "string" &&
        social.url.trim().length > 0,
    )
  : [];
const hasDetails = Boolean(email || phone || socials.length);
const description = asText(siteData.description);
---

<BaseLayout
  title={`Contact · ${siteName}`}
  description={description || `Contact ${siteName}.`}
>
  <div class="editorial-canvas editorial-contact">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>Contact <span aria-hidden="true">/</span> {siteName}</p>
        <p>{site.location}</p>
      </div>
      <div class="editorial-content">
        <header
          class="editorial-hero contact-hero"
          aria-labelledby="contact-title"
        >
          <h1 id="contact-title">Contact</h1>
        </header>

        {
          (location.length > 0 || hasDetails) && (
            <section
              class="editorial-section contact-section"
              aria-label="Lab contact details"
            >
              <div
                class:list={[
                  "contact-grid",
                  { "contact-grid--single": !location.length || !hasDetails },
                ]}
              >
                {location.length > 0 && (
                  <div class="contact-intro">
                    <h2>Location</h2>
                    <address>
                      {location.map((line) => (
                        <span>{line}</span>
                      ))}
                    </address>
                  </div>
                )}
                {hasDetails && (
                  <div class="contact-details">
                    {email && (
                      <div class="detail-block">
                        <h2>Email</h2>
                        <p>Dr. Tushar Shaw</p>
                        <a class="email-link" href={`mailto:${email}`}>
                          {email} <span aria-hidden="true">↗</span>
                        </a>
                      </div>
                    )}
                    {phone && (
                      <div class="detail-block">
                        <h2>Phone</h2>
                        <a href={`tel:${phone.replace(/[^+\d]/g, "")}`}>
                          {phone}
                        </a>
                      </div>
                    )}
                    {socials.length > 0 && (
                      <div class="detail-block">
                        <h2>Elsewhere</h2>
                        <ul>
                          {socials.map((social) => (
                            <li>
                              <a
                                href={social.url}
                                target="_blank"
                                rel="noreferrer"
                              >
                                {social.label}{" "}
                                <span aria-hidden="true">↗</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                )}
              </div>
            </section>
          )
        }

        <nav class="contact-links" aria-label="Related pages">
          <a class="editorial-link" href={withBase("/research/")}
            >Research <span aria-hidden="true">→</span></a
          >
          <a class="editorial-link" href={withBase("/join/")}
            >Join or collaborate <span aria-hidden="true">→</span></a
          >
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .editorial-contact {
    --c-rule: var(--editorial-line, #c9ccc2);
    --c-muted: var(--editorial-muted, #64736f);
    --c-teal: var(--editorial-teal, #276d6a);
  }

  .contact-hero {
    display: block;
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .contact-section {
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.72fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: start;
  }

  .contact-grid--single {
    grid-template-columns: 1fr;
  }

  .contact-intro h2 {
    margin: 0 0 0.8rem;
  }

  .email-link {
    overflow-wrap: anywhere;
  }

  .contact-details {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .detail-block {
    padding-top: 0.85rem;
    border-top: 1px solid var(--c-rule, var(--line));
  }

  .detail-block h2 {
    margin-bottom: 0.55rem;
    font-family: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  address {
    color: var(--c-muted, var(--ink-muted));
    font-style: normal;
  }

  address span {
    display: block;
  }

  .detail-block a {
    color: var(--c-teal, var(--teal-deep));
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .detail-block ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail-block li + li {
    margin-top: 0.45rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem;
  }

  .editorial-link {
    color: var(--c-teal, var(--teal-deep));
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 48rem) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
