---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../components/content";
import site from "../../data/site.json";
import updates from "../../data/updates.json";

const entries = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    hasBody: Boolean(entry.body?.trim()),
  })),
);

---

<BaseLayout
  title="Funding"
  description={`Funding information shared by ${site.shortName}.`}
>
  <div class="editorial-canvas funding-page">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>Funding <span aria-hidden="true">/</span> {site.shortName}</p>
        <p>Funding</p>
      </div>

      <div class="editorial-content">
        <header class="funding-hero" aria-labelledby="funding-title">
          <h1 id="funding-title">Funding</h1>
        </header>

        <section class="funding-list" aria-label="Funding">

          {
            rendered.length ? (
              <div class="funding-records">
                {rendered.map(({ entry, Content, hasBody }, index) => (
                  <article class="funding-record" id={entry.id}>
                    <p class="funding-record__number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </p>
                    <div class="funding-record__body">
                      <h2>{entry.data.title}</h2>
                      {(entry.data.funder || entry.data.period || entry.data.role || entry.data.amount) && (
                        <dl class="funding-meta">
                          {entry.data.funder && <div><dt>Provider</dt><dd>{entry.data.funder}</dd></div>}
                          {entry.data.period && <div><dt>Period</dt><dd>{entry.data.period}</dd></div>}
                          {entry.data.role && <div><dt>Role</dt><dd>{entry.data.role}</dd></div>}
                          {entry.data.amount && <div><dt>Amount</dt><dd>{entry.data.amount}</dd></div>}
                        </dl>
                      )}
                      {hasBody && <div class="prose"><Content /></div>}
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <p class="empty-state">{updates.funding.emptyState}</p>
            )
          }
        </section>

        <nav class="funding-links" aria-label="Explore related research">
          <a class="editorial-button" href={withBase("/research/")}
            >Research themes <span aria-hidden="true">↗</span></a
          >
          <a class="editorial-button" href={withBase("/publications/")}
            >Publications <span aria-hidden="true">↗</span></a
          >
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .funding-page {
    --editorial-ink: var(--ink);
    --editorial-navy: var(--navy);
    --editorial-teal: var(--teal);
    --editorial-ivory: var(--canvas);
    --editorial-line: var(--line);
    --editorial-muted: var(--muted);
    color: var(--editorial-ink);
    background: var(--editorial-ivory);
  }

  .funding-hero {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--editorial-line);
  }

  .funding-hero h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--editorial-navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.8rem, 6.5vw, 5.6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .funding-list {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }



  .funding-record__number {
    margin: 0;
    color: var(--editorial-teal);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .funding-records {
    border-top: 1px solid var(--editorial-line);
  }

  .funding-record {
    display: grid;
    grid-template-columns: minmax(3rem, 0.25fr) minmax(0, 2fr);
    gap: clamp(1rem, 5vw, 5rem);
    padding-block: clamp(1.7rem, 3vw, 2.75rem);
    border-bottom: 1px solid var(--editorial-line);
  }

  .funding-record__number {
    margin-top: 0.25rem;
  }

  .funding-record h2 {
    margin: 0;
    color: var(--editorial-navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.55rem, 3vw, 2.45rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .funding-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 1.1rem 0 0;
    padding-block: 0.85rem;
    border-block: 1px solid var(--editorial-line);
  }

  .funding-meta div {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: baseline;
  }

  .funding-meta dt {
    color: var(--editorial-teal);
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .funding-meta dd {
    margin: 0;
    color: var(--editorial-ink);
    font-size: 0.92rem;
  }

  .prose {
    max-width: 46rem;
    margin-top: 1rem;
    color: var(--editorial-muted);
    line-height: 1.6;
  }

  .prose :global(p) {
    margin: 0 0 0.8rem;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(a) {
    color: var(--editorial-teal);
  }


  .empty-state {
    padding: 1.2rem 0;
    border-block: 1px dashed var(--editorial-line);
    color: var(--editorial-muted);
  }

  .funding-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    padding-block: 0 clamp(3rem, 6vw, 5rem);
  }

  @media (max-width: 42rem) {
    .funding-hero {
      display: block;
    }


    .funding-record {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 1rem;
    }

    .funding-meta {
      grid-template-columns: 1fr;
    }
  }
</style>
