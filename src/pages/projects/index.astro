---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { asText, withBase } from "../../components/content";
import site from "../../data/site.json";
import updates from "../../data/updates.json";

const entries = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    hasBody: Boolean(entry.body?.trim()),
  })),
);

function listed(value: unknown): string {
  return asText(value, "Not listed") || "Not listed";
}
---

<BaseLayout
  title="Funding"
  description={`Funding information shared by ${site.shortName}.`}
>
  <div class="editorial-canvas funding-page">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>Funding <span aria-hidden="true">/</span> {site.shortName}</p>
        <p>Project record</p>
      </div>

      <div class="editorial-content">
        <header class="funding-hero" aria-labelledby="funding-title">
          <div>
            <p class="editorial-kicker">Funding / Project record</p>
            <h1 id="funding-title">Work with support.</h1>
          </div>
          <p>{updates.funding.heroIntro}</p>
        </header>

        <section class="funding-list" aria-labelledby="funding-list-title">
          <div class="funding-list__heading">
            <p class="editorial-index">
              01 <span aria-hidden="true">/</span> Funding archive
            </p>
            <div>
              <h2 id="funding-list-title">Project details</h2>
              <p>{updates.funding.sectionIntro}</p>
            </div>
          </div>

          {
            rendered.length ? (
              <div class="funding-records">
                {rendered.map(({ entry, Content, hasBody }, index) => (
                  <article class="funding-record" id={entry.id}>
                    <p class="funding-record__number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </p>
                    <div class="funding-record__body">
                      <h3>{entry.data.title}</h3>
                      <dl class="funding-meta">
                        <div>
                          <dt>Provider</dt>
                          <dd>{listed(entry.data.funder)}</dd>
                        </div>
                        <div>
                          <dt>Period</dt>
                          <dd>{listed(entry.data.period)}</dd>
                        </div>
                        <div>
                          <dt>Role</dt>
                          <dd>{listed(entry.data.role)}</dd>
                        </div>
                        <div>
                          <dt>Amount</dt>
                          <dd>{listed(entry.data.amount)}</dd>
                        </div>
                      </dl>
                      <div class="prose">
                        {hasBody ? (
                          <Content />
                        ) : (
                          <p class="not-listed">No further project details listed.</p>
                        )}
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <p class="empty-state">{updates.funding.emptyState}</p>
            )
          }
        </section>

        <nav class="funding-links" aria-label="Explore related research">
          <a class="editorial-button" href={withBase("/research/")}
            >Research themes <span aria-hidden="true">↗</span></a
          >
          <a class="editorial-button" href={withBase("/publications/")}
            >Publications <span aria-hidden="true">↗</span></a
          >
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .funding-page {
    --editorial-ink: var(--ink);
    --editorial-navy: var(--navy);
    --editorial-teal: var(--teal);
    --editorial-ivory: var(--canvas);
    --editorial-line: var(--line);
    --editorial-muted: var(--muted);
    color: var(--editorial-ink);
    background: var(--editorial-ivory);
  }

  .funding-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(14rem, 0.7fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    padding-block: clamp(4rem, 9vw, 7.5rem);
    border-bottom: 1px solid var(--editorial-line);
  }

  .funding-hero h1 {
    max-width: 12ch;
    margin: 0.85rem 0 0;
    color: var(--editorial-navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.8rem, 6.5vw, 5.6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .funding-hero > p {
    max-width: 25rem;
    margin: 0;
    color: var(--editorial-muted);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .funding-list {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .funding-list__heading {
    display: grid;
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.8fr);
    gap: clamp(1.5rem, 6vw, 6rem);
    align-items: start;
    margin-bottom: 2.5rem;
  }

  .funding-list__heading h2 {
    margin: 0 0 0.65rem;
    color: var(--editorial-navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.9rem, 3.3vw, 3rem);
    font-weight: 400;
    line-height: 1.08;
  }

  .funding-list__heading p:last-child {
    margin: 0;
    color: var(--editorial-muted);
  }

  .editorial-index,
  .funding-record__number {
    margin: 0;
    color: var(--editorial-teal);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .funding-records {
    border-top: 1px solid var(--editorial-line);
  }

  .funding-record {
    display: grid;
    grid-template-columns: minmax(3rem, 0.25fr) minmax(0, 2fr);
    gap: clamp(1rem, 5vw, 5rem);
    padding-block: clamp(1.7rem, 3vw, 2.75rem);
    border-bottom: 1px solid var(--editorial-line);
  }

  .funding-record__number {
    margin-top: 0.25rem;
  }

  .funding-record h3 {
    margin: 0;
    color: var(--editorial-navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.55rem, 3vw, 2.45rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .funding-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 1.1rem 0 0;
    padding-block: 0.85rem;
    border-block: 1px solid var(--editorial-line);
  }

  .funding-meta div {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: baseline;
  }

  .funding-meta dt {
    color: var(--editorial-teal);
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .funding-meta dd {
    margin: 0;
    color: var(--editorial-ink);
    font-size: 0.92rem;
  }

  .prose {
    max-width: 46rem;
    margin-top: 1rem;
    color: var(--editorial-muted);
    line-height: 1.6;
  }

  .prose :global(p) {
    margin: 0 0 0.8rem;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(a) {
    color: var(--editorial-teal);
  }

  .not-listed {
    font-style: italic;
  }

  .empty-state {
    padding: 1.2rem 0;
    border-block: 1px dashed var(--editorial-line);
    color: var(--editorial-muted);
  }

  .funding-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    padding-block: 0 clamp(3rem, 6vw, 5rem);
  }

  @media (max-width: 42rem) {
    .funding-hero {
      display: block;
    }

    .funding-hero > p {
      margin-top: 1.75rem;
    }

    .funding-list__heading {
      display: block;
    }

    .funding-list__heading > div {
      margin-top: 1.25rem;
    }

    .funding-record {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 1rem;
    }

    .funding-meta {
      grid-template-columns: 1fr;
    }
  }
</style>
