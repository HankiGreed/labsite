---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonCard from "../../components/PersonCard.astro";
import site from "../../data/site.json";

const people = (await getCollection("people")).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    a.data.name.localeCompare(b.data.name) ||
    a.id.localeCompare(b.id),
);
const groups = [
  {
    key: "leadership",
    label: "Principal Investigator",
    copy: "Laboratory leadership and direction.",
  },
  {
    key: "researchers",
    label: "Research Staff",
    copy: "Research staff working across the laboratory's scientific methods.",
  },
  {
    key: "students",
    label: "Student Interns",
    copy: "Student interns contributing to the laboratory's work.",
  },
  {
    key: "alumni",
    label: "Alumni",
    copy: "Former members of the laboratory.",
  },
] as const;
---

<BaseLayout
  title={`People · ${site.shortName}`}
  description="Meet the Tushar Shaw Lab team."
>
  <div class="editorial-canvas editorial-people">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>Team <span aria-hidden="true">/</span> {site.shortName}</p>
        <p>Laboratory directory</p>
      </div>
      <div class="editorial-content">
        <header class="editorial-hero" aria-labelledby="people-title">
          <p class="editorial-kicker">The people / Team</p>
          <h1 id="people-title">The Tushar Shaw Lab team.</h1>
          <p class="editorial-hero__intro">
            The Tushar Shaw Lab brings together a principal investigator,
            research staff, student interns, and alumni at M.S. Ramaiah
            University of Applied Sciences (RUAS), Bengaluru, India.
          </p>
        </header>

        <section class="editorial-section" aria-labelledby="group-title">
          <div class="section-intro">
            <p class="editorial-index">
              01 <span aria-hidden="true">/</span> The group
            </p>
            <h2 id="group-title">The people behind the work</h2>
            <p>
              The team studies infectious diseases and bacterial pathogens,
              developing rapid, reliable, and cost-effective diagnostics.
            </p>
          </div>
          {
            groups.map((group, index) => {
              const entries = people.filter(
                (entry) => entry.data.group === group.key,
              );
              return (
                <section
                  class="people-group"
                  aria-labelledby={`${group.key}-title`}
                >
                  <div class="people-group__heading">
                    <p class="editorial-index">
                      {String(index + 1).padStart(2, "0")}{" "}
                      <span aria-hidden="true">/</span>
                    </p>
                    <div>
                      <h3 id={`${group.key}-title`}>{group.label}</h3>
                      <p>{group.copy}</p>
                    </div>
                  </div>
                  {entries.length ? (
                    <div class="people-grid">
                      {entries.map((entry) => (
                        <PersonCard entry={entry} />
                      ))}
                    </div>
                  ) : (
                    <p class="empty-state">
                      No {group.label.toLowerCase()} profiles yet.
                    </p>
                  )}
                </section>
              );
            })
          }
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .editorial-people {
    --c-rule: var(--editorial-line, #c9ccc2);
    --c-muted: var(--editorial-muted, #64736f);
    --c-teal: var(--editorial-teal, #276d6a);
  }

  .editorial-people .editorial-hero__intro {
    max-width: 39rem;
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
    column-gap: clamp(1.5rem, 5vw, 5rem);
    align-items: start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--c-rule, var(--line));
  }

  .section-intro .editorial-index {
    grid-row: span 2;
  }

  .section-intro h2 {
    max-width: 21rem;
    margin-bottom: 0.65rem;
  }

  .section-intro p:last-child {
    max-width: 34rem;
    margin-bottom: 0;
    color: var(--c-muted, var(--ink-muted));
  }

  .people-group {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-block: 2.4rem;
    border-bottom: 1px solid var(--c-rule, var(--line));
  }

  .people-group__heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-content: start;
  }

  .people-group__heading h3 {
    margin-bottom: 0.5rem;
  }

  .people-group__heading p:last-child {
    margin-bottom: 0;
    color: var(--c-muted, var(--ink-muted));
    font-size: 0.95rem;
  }

  .editorial-index {
    margin: 0;
    color: var(--c-teal, var(--teal-deep));
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .people-grid {
    display: grid;
    gap: 0;
  }

  .people-grid :global(.person-card) {
    display: grid;
    grid-template-columns: minmax(7rem, 10rem) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.75rem);
    overflow: visible;
    padding-block: 1rem;
    border: 0;
    border-top: 1px solid var(--c-rule, var(--line));
    border-radius: 0;
    background: transparent;
  }

  .people-grid :global(.person-card:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .people-grid :global(.person-card__image),
  .people-grid :global(.person-card__avatar) {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 0;
  }

  .people-grid :global(.person-card__body) {
    align-content: start;
    gap: 0.45rem;
    padding: 0.15rem 0 0;
  }

  .people-grid :global(.person-card h3) {
    margin-bottom: 0.1rem;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
  }

  .people-grid :global(.person-card p) {
    margin-bottom: 0;
  }

  .people-grid :global(.person-card__role) {
    color: var(--c-teal, var(--teal-deep));
  }

  .people-grid :global(.person-card__links) {
    margin-top: 0.4rem;
  }

  .people-grid :global(.person-card__links a) {
    color: var(--c-teal, var(--teal-deep));
  }

  .empty-state {
    padding: 1rem 0;
    border-top: 1px dashed var(--c-rule, var(--line));
    color: var(--c-muted, var(--ink-muted));
  }

  @media (max-width: 48rem) {
    .people-group {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 38rem) {
    .section-intro {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .section-intro .editorial-index {
      grid-row: auto;
    }

    .people-grid :global(.person-card) {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
