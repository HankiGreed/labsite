---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonCard from "../../components/PersonCard.astro";
import site from "../../data/site.json";
import teamData from "../../data/team.json";

const people = (await getCollection("people")).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    a.data.name.localeCompare(b.data.name) ||
    a.id.localeCompare(b.id),
);
const renderedPeople = await Promise.all(
  people.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<BaseLayout title="Team" description={site.description}>
  <div class="editorial-canvas editorial-people">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>
          {teamData.page.kicker}
          <span aria-hidden="true">/</span>
          {site.shortName}
        </p>
        <p>{teamData.page.barLabel}</p>
      </div>
      <div class="editorial-content">
        <header
          class="editorial-hero people-hero"
          aria-labelledby="people-title"
        >
          <h1 id="people-title">{teamData.page.title}</h1>
        </header>

        <section class="editorial-section people-section">
          {
            teamData.groups.map((group, index) => {
              const entries = renderedPeople.filter(
                ({ entry }) => entry.data.group === group.key,
              );
              return (
                <section
                  class="people-group"
                  aria-labelledby={`${group.key}-title`}
                >
                  <div class="people-group__heading">
                    <p class="editorial-index">
                      {String(index + 1).padStart(2, "0")}
                    </p>
                    <h2 id={`${group.key}-title`}>{group.label}</h2>
                  </div>
                  {entries.length ? (
                    <div class="people-grid">
                      {entries.map(({ entry, Content }) =>
                        entry.data.group === "students" ||
                        entry.data.group === "alumni" ? (
                          <PersonCard entry={entry} />
                        ) : (
                          <PersonCard entry={entry}>
                            <Content />
                          </PersonCard>
                        ),
                      )}
                    </div>
                  ) : (
                    <p class="empty-state">{group.empty}</p>
                  )}
                </section>
              );
            })
          }
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .editorial-people {
    --c-rule: var(--line);
    --c-muted: var(--muted);
    --c-teal: var(--teal);
  }

  .people-hero {
    display: block;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .people-hero h1 {
    margin-top: 0;
  }

  .people-section {
    padding-bottom: 0;
  }

  .people-group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--c-rule);
  }

  .people-group__heading {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .people-group__heading h2 {
    margin-bottom: 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }

  .people-grid {
    display: grid;
    gap: 0;
  }

  .empty-state {
    padding: 1rem 0;
    border-top: 1px dashed var(--c-rule);
    color: var(--c-muted);
  }

  @media (max-width: 38rem) {
    .people-hero h1 {
      font-size: 2.1rem;
    }

    .people-group__heading {
      gap: 0.75rem;
    }

    .people-group__heading h2 {
      font-size: 1.4rem;
    }
  }
</style>
