---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonCard from "../../components/PersonCard.astro";
import site from "../../data/site.json";
import teamData from "../../data/team.json";

const people = (await getCollection("people")).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    a.data.name.localeCompare(b.data.name) ||
    a.id.localeCompare(b.id),
);
const renderedPeople = await Promise.all(
  people.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<BaseLayout
  title="Team"
  description={site.description}
>
  <div class="editorial-canvas editorial-people">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>{teamData.page.kicker} <span aria-hidden="true">/</span> {site.shortName}</p>
        <p>{teamData.page.barLabel}</p>
      </div>
      <div class="editorial-content">
        <header class="editorial-hero people-hero" aria-labelledby="people-title">
          <h1 id="people-title">{teamData.page.title}</h1>
        </header>

        <section class="editorial-section people-section">
          {
            teamData.groups.map((group, index) => {
              const entries = renderedPeople.filter(
                ({ entry }) => entry.data.group === group.key,
              );
              return (
                <section class="people-group" aria-labelledby={`${group.key}-title`}>
                  <div class="people-group__heading">
                    <p class="editorial-index">{String(index + 1).padStart(2, "0")}</p>
                    <h2 id={`${group.key}-title`}>{group.label}</h2>
                  </div>
                  {entries.length ? (
                    <div class="people-grid">
                      {entries.map(({ entry, Content }) => (
                        <PersonCard entry={entry}>
                          <Content />
                        </PersonCard>
                      ))}
                    </div>
                  ) : (
                    <p class="empty-state">{group.empty}</p>
                  )}
                </section>
              );
            })
          }
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .editorial-people {
    --c-rule: var(--line);
    --c-muted: var(--muted);
    --c-teal: var(--teal);
  }

  .people-hero {
    display: block;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .people-hero h1 {
    margin-top: 0;
  }

  .people-section {
    padding-bottom: 0;
  }


  .people-group {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--c-rule);
  }

  .people-group__heading {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .people-group__heading h2 {
    margin-bottom: 0.5rem;
  }

  .people-grid {
    display: grid;
    gap: 0;
  }

  .people-grid :global(.person-card) {
    display: grid;
    grid-template-columns: minmax(7rem, 10rem) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.75rem);
    padding-block: 1rem;
    border: 0;
    border-top: 1px solid var(--c-rule);
  }

  .people-grid :global(.person-card:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .people-grid :global(.person-card__image),
  .people-grid :global(.person-card__avatar) {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 0;
  }

  .people-grid :global(.person-card__body) {
    align-content: start;
    gap: 0.45rem;
    padding: 0.15rem 0 0;
  }

  .people-grid :global(.person-card h3) {
    margin-bottom: 0.1rem;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
  }

  .people-grid :global(.person-card p) {
    margin-bottom: 0;
  }

  .people-grid :global(.person-card__role) {
    color: var(--c-teal);
  }

  .people-grid :global(.person-card__prose) {
    color: var(--c-muted);
  }

  .people-grid :global(.person-card__links) {
    margin-top: 0.4rem;
  }

  .people-grid :global(.person-card__links a) {
    color: var(--c-teal);
  }

  .empty-state {
    padding: 1rem 0;
    border-top: 1px dashed var(--c-rule);
    color: var(--c-muted);
  }

  @media (max-width: 48rem) {
    .people-group {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 38rem) {

    .people-grid :global(.person-card) {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
