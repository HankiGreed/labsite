---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../components/content";
import site from "../../data/site.json";

const groups = [
  { key: "respiratory", label: "Respiratory Pathogens" },
  { key: "antimicrobial-resistant", label: "Antimicrobial-Resistant Bacteria" },
  { key: "hypervirulent", label: "Hypervirulent Pathogens" },
  {
    key: "endodontic-other",
    label: "Endodontic and Other Bacterial Pathogens",
  },
  { key: "fungal", label: "Fungal Pathogens" },
];
const entries = (await getCollection("pathogens")).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const grouped = groups.map((group) => ({
  ...group,
  entries: entries.filter((entry) => entry.data.group === group.key),
}));
---

<BaseLayout
  title={`Pathogens · ${site.shortName}`}
  description="Pathogens of interest to the Tushar Shaw Lab, grouped by research area."
>
  <div class="editorial-canvas pathogens-page">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>Editorial journal <span aria-hidden="true">/</span> Pathogens</p>
        <p>{site.shortName}</p>
      </div>

      <div class="editorial-content">
        <header class="pathogens-hero" aria-labelledby="pathogens-title">
          <div>
            <p class="editorial-kicker">Pathogens of interest</p>
            <h1 id="pathogens-title">
              The organisms at the centre of the work.
            </h1>
          </div>
          <p>
            The lab studies bacterial carriage and transmission, pathogen
            diversity, virulence, antimicrobial resistance, respiratory
            pathogens, Gram-negative bacteria, and emerging infections.
          </p>
        </header>

        <div class="pathogen-groups">
          {
            grouped.map((group, index) => (
              <section
                class="pathogen-group"
                aria-labelledby={`pathogen-group-${group.key}`}
              >
                <div class="pathogen-group__heading">
                  <p class="editorial-index">
                    {String(index + 1).padStart(2, "0")}{" "}
                    <span aria-hidden="true">/</span> Pathogens
                  </p>
                  <h2 id={`pathogen-group-${group.key}`}>{group.label}</h2>
                </div>
                {group.entries.length ? (
                  <div class="pathogen-list">
                    {group.entries.map((entry) => (
                      <article class="pathogen-entry" id={entry.id}>
                        <h3>
                          <em>{entry.data.name}</em>
                        </h3>
                        <p>{entry.data.summary}</p>
                      </article>
                    ))}
                  </div>
                ) : (
                  <p class="empty-state">
                    No pathogens are listed in this category.
                  </p>
                )}
              </section>
            ))
          }
        </div>

        <nav class="pathogens-links" aria-label="Explore related research">
          <a class="editorial-button" href={withBase("/research/")}
            >Research themes <span aria-hidden="true">↗</span></a
          >
          <a class="editorial-button" href={withBase("/projects/")}
            >Projects <span aria-hidden="true">↗</span></a
          >
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .pathogens-page {
    --editorial-ink: var(--ink);
    --editorial-navy: var(--navy);
    --editorial-teal: var(--teal);
    --editorial-teal-soft: var(--teal-soft);
    --editorial-ivory: var(--canvas);
    --editorial-paper: var(--paper);
    --editorial-line: var(--line);
    --editorial-muted: var(--muted);
    color: var(--editorial-ink);
    background: var(--editorial-ivory);
  }
  .pathogens-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(14rem, 0.65fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    padding-block: clamp(4rem, 9vw, 7.5rem);
    border-bottom: 1px solid var(--editorial-line);
  }
  .pathogens-hero h1 {
    max-width: 12ch;
    margin: 0.85rem 0 0;
    color: var(--editorial-navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.8rem, 6.5vw, 5.6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .pathogens-hero > p {
    max-width: 25rem;
    margin: 0;
    color: var(--editorial-muted);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.1rem;
    line-height: 1.5;
  }
  .pathogen-groups {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .pathogen-group {
    display: grid;
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.8fr);
    gap: clamp(1.5rem, 6vw, 6rem);
    padding-block: 2rem;
    border-bottom: 1px solid var(--editorial-line);
  }
  .pathogen-group:first-child {
    padding-top: 0;
  }
  .pathogen-group__heading h2 {
    margin: 0.75rem 0 0;
    color: var(--editorial-navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.65rem, 3vw, 2.65rem);
    font-weight: 400;
    line-height: 1.08;
  }
  .pathogen-list {
    border-top: 1px solid var(--editorial-line);
  }
  .pathogen-entry {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--editorial-line);
  }
  .pathogen-entry:last-child {
    border-bottom: 0;
  }
  .pathogen-entry h3 {
    margin: 0;
    color: var(--editorial-navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-weight: 400;
    line-height: 1.2;
  }
  .pathogen-entry p {
    max-width: 42rem;
    margin: 0.55rem 0 0;
    color: var(--editorial-muted);
    line-height: 1.55;
  }
  .empty-state {
    padding: 1.15rem 0;
    border-block: 1px dashed var(--editorial-line);
    color: var(--editorial-muted);
    line-height: 1.5;
  }
  .pathogens-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    padding-block: 0 clamp(3rem, 6vw, 5rem);
  }
  @media (max-width: 42rem) {
    .pathogens-hero {
      display: block;
    }
    .pathogens-hero > p {
      margin-top: 1.75rem;
    }
    .pathogen-group {
      display: block;
    }
    .pathogen-group__heading {
      margin-bottom: 1.5rem;
    }
  }
</style>
