---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResearchCard from "../../components/ResearchCard.astro";
import { withBase } from "../../components/content";
import site from "../../data/site.json";
import researchData from "../../data/research.json";

const entries = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
const pathogens = (await getCollection("pathogens")).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const pathogenGroups = researchData.pathogens.groups.map((group) => ({
  ...group,
  entries: pathogens.filter((entry) => entry.data.group === group.key),
}));
---

<BaseLayout
  title="Research"
  description={researchData.page.intro}
>
  <div class="editorial-canvas research-page">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>{researchData.page.kicker} <span aria-hidden="true">/</span> {site.shortName}</p>
        <p>{researchData.page.edition}</p>
      </div>

      <div class="editorial-content">
        <header class="editorial-hero research-hero" aria-labelledby="research-title">
          <div class="research-hero__meta">
            <p class="editorial-kicker">{researchData.page.kicker}</p>
            <p class="research-hero__edition">{researchData.page.edition}</p>
          </div>
          <div class="research-hero__copy">
            <h1 id="research-title">{researchData.page.title}</h1>
            <p>{researchData.page.intro}</p>
          </div>
          <aside class="research-hero__aside" aria-label={researchData.page.methodsLabel}>
            <p class="research-hero__aside-label">{researchData.page.methodsLabel}</p>
            <p>{researchData.page.methods}</p>
          </aside>
        </header>

        <section class="editorial-section research-section" aria-labelledby="themes-title">
          <div class="section-heading">
            <p class="editorial-index">{researchData.themes.index}</p>
            <div>
              <h2 id="themes-title">{researchData.themes.title}</h2>
              <p>{researchData.themes.intro}</p>
            </div>
          </div>
          {
            rendered.length ? (
              <div class="research-grid">
                {rendered.map(({ entry, Content }, index) => (
                  <ResearchCard entry={entry}>
                    <span slot="number">{String(index + 1).padStart(2, "0")}</span>
                    <Content />
                  </ResearchCard>
                ))}
              </div>
            ) : (
              <p class="empty-state">{researchData.themes.empty}</p>
            )
          }
        </section>

        <section class="editorial-section pathogens-section" aria-labelledby="pathogens-title">
          <div class="section-heading">
            <p class="editorial-index">{researchData.pathogens.index}</p>
            <div>
              <h2 id="pathogens-title">{researchData.pathogens.title}</h2>
              <p>{researchData.pathogens.intro}</p>
            </div>
          </div>
          <div class="pathogen-groups">
            {
              pathogenGroups.map((group) => (
                <section class="pathogen-group" aria-labelledby={`pathogen-${group.key}`}>
                  <h3 id={`pathogen-${group.key}`}>{group.label}</h3>
                  {group.entries.length ? (
                    <ul>
                      {group.entries.map((entry) => (
                        <li>
                          <a href={`${withBase("/pathogens/")}#${entry.id}`}>
                            <em>{entry.data.name}</em>
                            <span aria-hidden="true">↗</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="empty-state">{researchData.pathogens.empty}</p>
                  )}
                </section>
              ))
            }
          </div>
        </section>

        <nav class="research-links" aria-label="Related research pages">
          {
            researchData.links.map((link) => (
              <a class="research-link" href={withBase(link.href)}>
                <span class="editorial-kicker">{link.caption}</span>
                <strong>{link.label} <span aria-hidden="true">↗</span></strong>
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .research-page {
    --editorial-ink: var(--ink);
    --editorial-navy: var(--navy);
    --editorial-teal: var(--teal);
    --editorial-teal-soft: var(--teal-soft);
    --editorial-ivory: var(--canvas);
    --editorial-paper: var(--paper);
    --editorial-line: var(--line);
    --editorial-muted: var(--muted);
    color: var(--editorial-ink);
    background: var(--editorial-ivory);
  }

  .research-hero {
    grid-template-columns: minmax(8rem, 0.65fr) minmax(0, 2.1fr) minmax(10rem, 0.75fr);
  }

  .research-hero__meta,
  .research-hero__aside {
    padding-top: 0.35rem;
  }

  .research-hero__edition {
    margin-top: 1.4rem;
    color: var(--editorial-muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .research-hero__aside {
    border-top: 1px solid var(--editorial-teal);
  }

  .research-hero__aside-label {
    margin: 0.8rem 0 0;
    color: var(--editorial-teal);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .research-hero__aside p:last-child {
    margin: 0.75rem 0 0;
    color: var(--editorial-muted);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .research-hero h1 {
    max-width: 13ch;
  }

  .research-hero__copy > p {
    max-width: 35rem;
    margin: 1.6rem 0 0;
    color: var(--editorial-muted);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.08rem, 1.8vw, 1.3rem);
    line-height: 1.45;
  }

  .research-section,
  .pathogens-section {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(8rem, 0.65fr) minmax(0, 2.1fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: start;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }

  .section-heading h2 {
    max-width: 19ch;
    margin-bottom: 0.8rem;
  }

  .section-heading p:last-child {
    max-width: 34rem;
    margin-bottom: 0;
    color: var(--editorial-muted);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(1.5rem, 4vw, 4rem);
    border-top: 1px solid var(--editorial-line);
  }

  .research-grid :global(.research-card) {
    min-width: 0;
    padding-block: 1.5rem 2rem;
    border-bottom: 1px solid var(--editorial-line);
  }

  .research-grid :global(.research-card__number) {
    order: -1;
  }

  .research-grid :global(.research-card__prose) {
    max-width: 38rem;
  }

  .pathogen-groups {
    border-top: 1px solid var(--editorial-line);
  }

  .pathogen-group {
    display: grid;
    grid-template-columns: minmax(11rem, 0.75fr) minmax(0, 1.8fr);
    gap: clamp(1.5rem, 6vw, 6rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--editorial-line);
  }

  .pathogen-group h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
  }

  .pathogen-group ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pathogen-group li {
    border-bottom: 1px solid var(--editorial-line);
  }

  .pathogen-group a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
    color: var(--editorial-navy);
    text-decoration: none;
  }

  .pathogen-group a span {
    color: var(--editorial-teal);
  }

  .pathogen-group a:hover,
  .pathogen-group a:focus-visible {
    color: var(--editorial-teal);
  }

  .empty-state {
    padding: 1rem 0;
    border-top: 1px dashed var(--editorial-line);
    color: var(--editorial-muted);
  }

  .research-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border-top: 1px solid var(--editorial-line);
    background: var(--editorial-line);
  }

  .research-link {
    display: block;
    min-height: 9rem;
    padding: 1.5rem;
    background: var(--editorial-paper);
    color: var(--editorial-navy);
    text-decoration: none;
  }

  .research-link strong {
    display: block;
    margin-top: 1rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 400;
  }

  .research-link:hover strong,
  .research-link:focus-visible strong {
    color: var(--editorial-teal);
  }

  @media (max-width: 48rem) {
    .research-hero,
    .section-heading {
      grid-template-columns: minmax(6rem, 0.45fr) minmax(0, 1.55fr);
    }

    .research-hero__aside {
      grid-column: 2;
    }

    .research-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    .research-hero,
    .section-heading,
    .pathogen-group {
      display: block;
    }

    .research-hero__copy,
    .section-heading > div,
    .pathogen-group ul {
      margin-top: 1.5rem;
    }

    .research-hero__aside {
      margin-top: 2rem;
    }

    .pathogen-group ul {
      grid-template-columns: 1fr;
    }

    .research-links {
      grid-template-columns: 1fr;
    }
  }
</style>
