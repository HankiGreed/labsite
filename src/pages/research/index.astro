---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResearchCard from "../../components/ResearchCard.astro";
import { withBase } from "../../components/content";
import researchData from "../../data/research.json";

const entries = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<BaseLayout title="Research">
  <div class="editorial-canvas research-page">
    <div class="editorial-sheet">
      <div class="editorial-content">
        <section
          class="editorial-section research-section"
          aria-labelledby="themes-title"
        >
          <h1 id="themes-title">Research</h1>
          {
            rendered.length ? (
              <div class="research-grid">
                {rendered.map(({ entry, Content }, index) => (
                  <ResearchCard entry={entry}>
                    <span slot="number">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <Content />
                  </ResearchCard>
                ))}
              </div>
            ) : (
              <p class="empty-state">{researchData.themes.empty}</p>
            )
          }
        </section>

        <nav class="research-links" aria-label="Related research pages">
          {
            researchData.links.map((link) => (
              <a class="research-link" href={withBase(link.href)}>
                <strong>
                  {link.label} <span aria-hidden="true">↗</span>
                </strong>
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function openTargetedResearch() {
    let id: string;
    try {
      id = decodeURIComponent(window.location.hash.slice(1));
    } catch {
      return;
    }
    if (!id) return;
    const target = document.getElementById(id);
    const card = target?.closest(".research-card");
    const button = card?.querySelector<HTMLButtonElement>(
      ".research-card__title",
    );
    const panel = document.getElementById(
      button?.getAttribute("aria-controls") ?? "",
    );
    if (!button || !panel) return;
    button.setAttribute("aria-expanded", "true");
    panel.hidden = false;
    requestAnimationFrame(() => target?.scrollIntoView());
  }

  openTargetedResearch();
  window.addEventListener("hashchange", openTargetedResearch);
  document.addEventListener("astro:page-load", openTargetedResearch);
</script>

<style>
  .research-page {
    --editorial-ink: var(--ink);
    --editorial-navy: var(--navy);
    --editorial-teal: var(--teal);
    --editorial-teal-soft: var(--teal-soft);
    --editorial-ivory: var(--canvas);
    --editorial-paper: var(--paper);
    --editorial-line: var(--line);
    --editorial-muted: var(--muted);
    color: var(--editorial-ink);
    background: var(--editorial-ivory);
  }

  .research-section {
    padding-block: 1.5rem 2rem;
  }

  .research-section h1 {
    margin-bottom: 1.5rem;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(1.5rem, 4vw, 4rem);
    border-top: 1px solid var(--editorial-line);
  }

  .research-grid :global(.research-card) {
    min-width: 0;
    padding-block: 1.5rem 2rem;
    border-bottom: 1px solid var(--editorial-line);
  }

  .research-grid :global(.research-card__prose) {
    max-width: 38rem;
  }

  .empty-state {
    padding: 1rem 0;
    border-top: 1px dashed var(--editorial-line);
    color: var(--editorial-muted);
  }

  .research-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    border-top: 1px solid var(--editorial-line);
    background: var(--editorial-line);
  }

  .research-link {
    display: block;
    padding: 1.5rem;
    background: var(--editorial-paper);
    color: var(--editorial-navy);
    text-decoration: none;
  }

  .research-link strong {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 400;
  }

  .research-link:hover strong,
  .research-link:focus-visible strong {
    color: var(--editorial-teal);
  }

  @media (max-width: 48rem) {
    .research-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
