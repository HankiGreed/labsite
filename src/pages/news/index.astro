---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  asText,
  imageAlt,
  imageSrc,
  isExternal,
  valueOf,
  withBase,
} from "../../components/content";
import site from "../../data/site.json";

const entries = (await getCollection("news")).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
);
const cards = entries.map((entry) => ({
  ...entry,
  slug: entry.id,
  data: { ...entry.data, date: entry.data.date.toISOString().slice(0, 10) },
}));
---

<BaseLayout
  title={`News · ${site.shortName}`}
  description="News and updates from Tushar Shaw Lab."
>
  <div class="editorial-canvas editorial-news">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>
          News &amp; notes <span aria-hidden="true">/</span>
          {site.shortName}
        </p>
        <p>Research updates</p>
      </div>
      <div class="editorial-content">
        <header class="editorial-hero" aria-labelledby="news-title">
          <p class="editorial-kicker">The notebook / Research updates</p>
          <h1 id="news-title">Research in motion.</h1>
          <p class="editorial-hero__intro">
            Updates from Tushar Shaw Lab on infectious diseases, bacterial
            pathogens, and rapid, reliable, cost-effective diagnostics.
          </p>
        </header>

        <section class="editorial-section" aria-labelledby="archive-title">
          <div class="archive-intro">
            <p class="editorial-index">
              01 <span aria-hidden="true">/</span> The notebook
            </p>
            <div>
              <h2 id="archive-title">Recent updates</h2>
              <p>
                Published updates from the lab will collect news, events, and
                observations here.
              </p>
            </div>
          </div>
          {
            cards.length ? (
              <div class="dispatch-list">
                {cards.map((entry) => {
                  const title = asText(
                    valueOf(entry, "title", "name"),
                    "News update",
                  );
                  const date = asText(
                    valueOf(entry, "date", "publishedAt", "year"),
                  );
                  const summary = asText(
                    valueOf(entry, "summary", "excerpt", "description", "body"),
                  );
                  const image = valueOf(entry, "image", "photo");
                  const imageUrl = imageSrc(image);
                  const rawLink = asText(valueOf(entry, "link", "url"));
                  const linkValue = rawLink || `/news/${entry.slug}/`;
                  const link = isExternal(linkValue)
                    ? linkValue
                    : withBase(linkValue);
                  return (
                    <article class="dispatch-row">
                      {imageUrl ? (
                        <img
                          class="dispatch-row__image"
                          src={imageUrl}
                          alt={imageAlt(image, title)}
                          loading="lazy"
                        />
                      ) : (
                        <div
                          class="dispatch-row__image dispatch-row__image--empty"
                          aria-hidden="true"
                        >
                          <span>—</span>
                        </div>
                      )}
                      <div class="dispatch-row__body">
                        {date && <time datetime={date}>{date}</time>}
                        <h3>
                          <a
                            href={link}
                            target={
                              isExternal(linkValue) ? "_blank" : undefined
                            }
                            rel={
                              isExternal(linkValue) ? "noreferrer" : undefined
                            }
                          >
                            {title}
                          </a>
                        </h3>
                        {summary && <p>{summary}</p>}
                        <a
                          class="editorial-link"
                          href={link}
                          target={isExternal(linkValue) ? "_blank" : undefined}
                          rel={isExternal(linkValue) ? "noreferrer" : undefined}
                        >
                          Read story <span aria-hidden="true">↗</span>
                        </a>
                      </div>
                    </article>
                  );
                })}
              </div>
            ) : (
              <p class="empty-state">
                Updates will appear here when they are published.
              </p>
            )
          }
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .editorial-news {
    --c-rule: var(--editorial-line, #c9ccc2);
    --c-muted: var(--editorial-muted, #64736f);
    --c-teal: var(--editorial-teal, #276d6a);
    --c-teal-soft: var(--editorial-teal-soft, #dbe8e1);
  }

  .archive-intro {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--c-rule, var(--line));
  }

  .archive-intro h2 {
    margin-bottom: 0.65rem;
  }

  .archive-intro p:last-child {
    max-width: 37rem;
    margin-bottom: 0;
    color: var(--c-muted, var(--ink-muted));
  }

  .editorial-index {
    margin: 0;
    color: var(--c-teal, var(--teal-deep));
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .dispatch-list {
    display: grid;
  }

  .dispatch-row {
    display: grid;
    grid-template-columns: minmax(9rem, 13rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--c-rule, var(--line));
  }

  .dispatch-row__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .dispatch-row__image--empty {
    display: grid;
    place-items: center;
    color: var(--c-teal, var(--teal-deep));
    background: var(--c-teal-soft, var(--mint-soft));
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2rem;
  }

  .dispatch-row__body {
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }

  .dispatch-row time {
    color: var(--c-teal, var(--teal-deep));
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .dispatch-row h3 {
    margin-bottom: 0;
    font-size: clamp(1.35rem, 2.5vw, 2rem);
  }

  .dispatch-row h3 a {
    text-decoration: none;
  }

  .dispatch-row h3 a:hover,
  .dispatch-row h3 a:focus-visible {
    color: var(--c-teal, var(--teal-deep));
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .dispatch-row p {
    max-width: 42rem;
    margin-bottom: 0;
  }

  .dispatch-row .editorial-link {
    margin-top: 0.25rem;
  }

  .empty-state {
    padding: 1rem 0;
    border-bottom: 1px dashed var(--c-rule, var(--line));
    color: var(--c-muted, var(--ink-muted));
  }

  @media (max-width: 38rem) {
    .archive-intro {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .dispatch-row {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
