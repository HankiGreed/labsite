---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  asText,
  imageAlt,
  imageSrc,
  isExternal,
  valueOf,
  withBase,
} from "../../components/content";
import site from "../../data/site.json";
import updates from "../../data/updates.json";

const entries = (await getCollection("news")).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

function dateParts(value: unknown): { label: string; iso: string } | undefined {
  if (!(value instanceof Date) || Number.isNaN(value.getTime())) return undefined;
  return {
    label: new Intl.DateTimeFormat("en", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    }).format(value),
    iso: value.toISOString().slice(0, 10),
  };
}
---

<BaseLayout
  title="News & events"
  description={`News and events from ${site.shortName}.`}
>
  <div class="editorial-canvas editorial-news">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>News &amp; events <span aria-hidden="true">/</span> {site.shortName}</p>
        <p>Updates</p>
      </div>

      <div class="editorial-content">
        <header class="editorial-hero" aria-labelledby="news-title">
          <p class="editorial-kicker">News / Events</p>
          <h1 id="news-title">Notes from the lab.</h1>
          <p class="editorial-hero__intro">{updates.news.heroIntro}</p>
        </header>

        <section class="editorial-section" aria-labelledby="updates-title">
          <div class="section-intro">
            <p class="editorial-index">
              01 <span aria-hidden="true">/</span> Updates
            </p>
            <div>
              <h2 id="updates-title">News and events</h2>
              <p>{updates.news.sectionIntro}</p>
            </div>
          </div>

          {
            rendered.length ? (
              <div class="news-list">
                {rendered.map(({ entry, Content }) => {
                  const title = asText(valueOf(entry, "title"), "News update");
                  const summary = asText(valueOf(entry, "summary"));
                  const image = valueOf(entry, "image");
                  const imageUrl = imageSrc(image);
                  const date = dateParts(valueOf(entry, "date"));
                  const rawUrl = asText(valueOf(entry, "url"));
                  const link = rawUrl
                    ? isExternal(rawUrl)
                      ? rawUrl
                      : withBase(rawUrl)
                    : "";
                  const external = Boolean(rawUrl && isExternal(rawUrl));
                  return (
                    <article
                      class:list={{
                        "news-entry": true,
                        "news-entry--with-image": Boolean(imageUrl),
                      }}
                    >
                      {imageUrl && (
                        <img
                          class="news-entry__image"
                          src={imageUrl}
                          alt={imageAlt(image, title)}
                          loading="lazy"
                        />
                      )}
                      <div class="news-entry__body">
                        {date && <time datetime={date.iso}>{date.label}</time>}
                        <h3>
                          {link ? (
                            <a
                              href={link}
                              target={external ? "_blank" : undefined}
                              rel={external ? "noreferrer" : undefined}
                            >
                              {title}
                            </a>
                          ) : (
                            title
                          )}
                        </h3>
                        {summary && <p class="news-entry__summary">{summary}</p>}
                        <div class="news-entry__content prose">
                          <Content />
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            ) : (
              <p class="empty-state">{updates.news.emptyState}</p>
            )
          }
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .editorial-news {
    --c-rule: var(--editorial-line, #c9ccc2);
    --c-muted: var(--editorial-muted, #64736f);
    --c-teal: var(--editorial-teal, #276d6a);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--c-rule, var(--line));
  }

  .section-intro h2 {
    margin-bottom: 0.65rem;
  }

  .section-intro p:last-child {
    max-width: 37rem;
    margin-bottom: 0;
    color: var(--c-muted, var(--ink-muted));
  }

  .editorial-index {
    margin: 0;
    color: var(--c-teal, var(--teal-deep));
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .news-list {
    display: grid;
  }

  .news-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.8rem;
    border-bottom: 1px solid var(--c-rule, var(--line));
  }

  .news-entry--with-image {
    grid-template-columns: minmax(8rem, 13rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: start;
  }

  .news-entry__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .news-entry__body {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    max-width: 48rem;
  }

  .news-entry time {
    color: var(--c-teal, var(--teal-deep));
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .news-entry h3 {
    margin-bottom: 0;
    font-size: clamp(1.35rem, 2.5vw, 2rem);
  }

  .news-entry h3 a {
    text-decoration: none;
  }

  .news-entry h3 a:hover,
  .news-entry h3 a:focus-visible {
    color: var(--c-teal, var(--teal-deep));
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .news-entry__summary {
    margin-bottom: 0;
    color: var(--c-muted, var(--ink-muted));
  }

  .news-entry__content {
    margin-top: 0.35rem;
    line-height: 1.65;
  }

  .news-entry__content :global(p) {
    margin-bottom: 0.8rem;
  }

  .news-entry__content :global(p:last-child) {
    margin-bottom: 0;
  }

  .news-entry__content :global(a) {
    color: var(--c-teal, var(--teal-deep));
  }

  .empty-state {
    padding: 1rem 0;
    border-bottom: 1px dashed var(--c-rule, var(--line));
    color: var(--c-muted, var(--ink-muted));
  }

  @media (max-width: 38rem) {
    .section-intro {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .news-entry--with-image {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
