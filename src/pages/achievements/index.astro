---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { asText, withBase } from "../../components/content";
import site from "../../data/site.json";

const siteName = asText(site.shortName ?? site.name, "Research Lab");
type Chronology = { year?: number; month?: number; date?: Date };

function entryYear(data: Chronology): number | undefined {
  if (data.date instanceof Date && !Number.isNaN(data.date.getTime())) {
    return data.date.getUTCFullYear();
  }
  return data.year;
}

function dateParts(
  data: Chronology,
): { label: string; iso: string } | undefined {
  if (data.date instanceof Date && !Number.isNaN(data.date.getTime())) {
    return {
      label: new Intl.DateTimeFormat("en", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
      }).format(data.date),
      iso: data.date.toISOString().slice(0, 10),
    };
  }
  if (data.year === undefined) return undefined;
  const year = String(data.year);
  if (data.month === undefined) return { label: year, iso: year };
  const months = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
  ];
  return {
    label: `${months[data.month - 1]} ${year}`,
    iso: `${year}-${String(data.month).padStart(2, "0")}`,
  };
}

const entries = (await getCollection("achievements")).sort(
  (a, b) =>
    (entryYear(b.data) ?? 0) - (entryYear(a.data) ?? 0) ||
    (a.data.order ?? Number.POSITIVE_INFINITY) -
      (b.data.order ?? Number.POSITIVE_INFINITY) ||
    a.data.title.localeCompare(b.data.title) ||
    a.id.localeCompare(b.id),
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
const years = [...new Set(entries.map((entry) => entryYear(entry.data)))];
const groups = years.map((year) => ({
  year,
  id: year === undefined ? "year-unspecified" : `year-${year}`,
  label: year === undefined ? undefined : String(year),
  items: rendered.filter(({ entry }) => entryYear(entry.data) === year),
}));
---

<BaseLayout
  title="Recognition"
  description={`Awards, invited sessions, conference presentations and research travel from ${siteName}.`}
>
  <div class="editorial-canvas recognition-page">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>Recognition <span aria-hidden="true">/</span> {siteName}</p>
        <p>Recognition</p>
      </div>

      <div class="editorial-content">
        <header class="editorial-hero" aria-labelledby="recognition-title">
          <h1 id="recognition-title">Recognition</h1>
        </header>

        <nav class="archive-years" aria-label="Browse achievements by year">
          {
            groups
              .filter((group) => group.year !== undefined)
              .map((group) => <a href={`#${group.id}`}>{group.label}</a>)
          }
        </nav>

        <div class="archive-record">
          {
            groups.map((group) => (
              <section
                class:list={[
                  "achievement-year",
                  { "achievement-year--undated": group.year === undefined },
                ]}
                id={group.year === undefined ? group.id : undefined}
                aria-labelledby={
                  group.year === undefined ? undefined : group.id
                }
                aria-label={
                  group.year === undefined ? "Other achievements" : undefined
                }
              >
                {group.year !== undefined && (
                  <header class="year-heading">
                    <h2 id={group.id}>{group.label}</h2>
                    <p>
                      {group.items.length}{" "}
                      {group.items.length === 1
                        ? "achievement"
                        : "achievements"}
                    </p>
                  </header>
                )}
                <div class="recognition-list">
                  {group.items.map(({ entry, Content }) => {
                    const date = dateParts(entry.data);
                    const images = entry.data.images ?? [];
                    const Heading = group.year === undefined ? "h2" : "h3";
                    return (
                      <article class="recognition-row" id={entry.id}>
                        <div class="recognition-row__heading">
                          {date && (
                            <time datetime={date.iso}>{date.label}</time>
                          )}
                          <Heading>{entry.data.title}</Heading>
                        </div>
                        <div
                          class:list={[
                            "recognition-row__body",
                            {
                              "recognition-row__body--with-photos":
                                images.length > 0,
                            },
                          ]}
                        >
                          {images.length > 0 && (
                            <div
                              class="achievement-photos"
                              role="group"
                              aria-label={`Photographs: ${entry.data.title}`}
                            >
                              {images.map((image, index) => (
                                <figure class="achievement-photo">
                                  <a
                                    href={withBase(image.src)}
                                    aria-label={`View full-size photograph ${index + 1}: ${image.alt}`}
                                  >
                                    <img
                                      src={withBase(image.src)}
                                      alt={image.alt}
                                      width={image.width}
                                      height={image.height}
                                      loading="lazy"
                                      decoding="async"
                                    />
                                    <span class="photo-view">
                                      View full size{" "}
                                      <span aria-hidden="true">↗</span>
                                    </span>
                                  </a>
                                  {image.caption && (
                                    <figcaption>{image.caption}</figcaption>
                                  )}
                                </figure>
                              ))}
                            </div>
                          )}
                          <div class="recognition-row__narrative">
                            <p class="recognition-row__summary">
                              {entry.data.summary}
                            </p>
                            <div class="prose">
                              <Content />
                            </div>
                          </div>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </section>
            ))
          }
        </div>

        <nav class="recognition-links" aria-label="Explore related pages">
          <a class="editorial-link" href={withBase("/research/")}
            >Research themes <span aria-hidden="true">→</span></a
          >
          <a class="editorial-link" href={withBase("/publications/")}
            >Publications <span aria-hidden="true">→</span></a
          >
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .recognition-page {
    --c-rule: var(--editorial-line, #c9ccc2);
    --c-muted: var(--editorial-muted, #64736f);
    --c-teal: var(--editorial-teal, #276d6a);
  }
  .recognition-page .editorial-hero {
    display: block;
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .archive-years {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.5rem;
    padding-block: 1.2rem;
    border-block: 1px solid var(--c-rule, var(--line));
  }

  .archive-years a {
    color: var(--c-teal, var(--teal-deep));
    font-size: 0.9rem;
    text-underline-offset: 0.25em;
  }

  .achievement-year {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .achievement-year--undated {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 0;
    border-top: 1px solid var(--c-teal, var(--teal-deep));
    scroll-margin-top: 6rem;
  }

  .year-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--c-teal, var(--teal-deep));
  }

  .year-heading h2 {
    margin: 0;
    scroll-margin-top: 6rem;
  }

  .year-heading p {
    margin: 0;
    color: var(--c-muted, var(--ink-muted));
    font-size: 0.8rem;
  }

  .recognition-row {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--c-rule, var(--line));
    scroll-margin-top: 6rem;
  }

  .recognition-row__body--with-photos {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: start;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .recognition-row__narrative {
    min-width: 0;
  }

  .recognition-row__heading time {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--c-teal, var(--teal-deep));
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .recognition-row__heading :is(h2, h3) {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .recognition-row__summary {
    margin: 0 0 1rem;
    color: var(--c-teal, var(--teal-deep));
    font-size: 0.87rem;
    font-weight: 650;
    line-height: 1.6;
  }

  .recognition-row .prose {
    max-width: 46rem;
    line-height: 1.75;
  }

  .recognition-row .prose :global(p) {
    margin: 0 0 1rem;
  }

  .recognition-row .prose :global(a) {
    color: var(--c-teal, var(--teal-deep));
  }

  .achievement-photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    align-items: start;
  }

  .achievement-photo {
    min-width: 0;
    margin: 0;
  }

  .achievement-photo a {
    display: block;
    border: 1px solid var(--c-rule, var(--line));
    color: var(--c-teal, var(--teal-deep));
    background: #e9ede5;
    text-decoration: none;
  }

  .achievement-photo img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 32rem;
    object-fit: contain;
  }

  .photo-view {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.8rem;
    border-top: 1px solid var(--c-rule, var(--line));
    font-size: 0.72rem;
    font-weight: 650;
  }

  .achievement-photo a:hover .photo-view {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .recognition-page a:focus-visible {
    outline: 3px solid var(--c-teal, var(--teal-deep));
    outline-offset: 4px;
  }

  .achievement-photo figcaption {
    padding-top: 0.6rem;
    color: var(--c-muted, var(--ink-muted));
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .recognition-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .editorial-link {
    color: var(--c-teal, var(--teal-deep));
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 48rem) {
    .recognition-row__body--with-photos {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 38rem) {
    .recognition-page .editorial-hero h1 {
      font-size: 2rem;
    }

    .year-heading h2 {
      font-size: 1.5rem;
    }

    .recognition-row__heading :is(h2, h3) {
      font-size: 1.2rem;
    }

    .achievement-photos {
      grid-template-columns: 1fr;
    }

    .achievement-photo img {
      max-height: none;
    }
  }
</style>
