---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { asText, withBase } from "../../components/content";
import site from "../../data/site.json";

const siteData = site as Record<string, unknown>;
const siteName = asText(siteData.shortName ?? siteData.name, "Research Lab");
const entries = (await getCollection("achievements")).sort((a, b) => {
  const aDate = a.data.date instanceof Date ? a.data.date.getTime() : 0;
  const bDate = b.data.date instanceof Date ? b.data.date.getTime() : 0;
  return (
    bDate - aDate ||
    a.data.title.localeCompare(b.data.title) ||
    a.id.localeCompare(b.id)
  );
});
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

function formattedDate(value: unknown): string | undefined {
  if (!(value instanceof Date) || Number.isNaN(value.getTime()))
    return undefined;
  return new Intl.DateTimeFormat("en", {
    month: "long",
    year: "numeric",
  }).format(value);
}
---

<BaseLayout
  title={`Achievements · ${siteName}`}
  description={`Achievements and distinctions from ${siteName}.`}
>
  <div class="editorial-canvas achievements-page">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>Achievements <span aria-hidden="true">/</span> {siteName}</p>
        <p>Record / Selected notes</p>
      </div>

      <div class="editorial-content">
        <header class="editorial-hero" aria-labelledby="achievements-title">
          <p class="editorial-kicker">Achievements / Record</p>
          <h1 id="achievements-title">What the work makes possible.</h1>
          <p class="editorial-hero__intro">
            This page records achievements shared by the lab, as they become
            available.
          </p>
        </header>

        <section class="editorial-section" aria-labelledby="record-title">
          <div class="section-intro">
            <p class="editorial-index">
              01 <span aria-hidden="true">/</span> The record
            </p>
            <div>
              <h2 id="record-title">A growing account of the work</h2>
              <p>
                Entries are presented with the dates and context supplied by the
                lab.
              </p>
            </div>
          </div>

          {
            rendered.length ? (
              <div class="achievement-list">
                {rendered.map(({ entry, Content }, index) => {
                  const date = formattedDate(entry.data.date);
                  const isoDate =
                    entry.data.date instanceof Date
                      ? entry.data.date.toISOString()
                      : undefined;
                  return (
                    <article class="achievement-row" id={entry.id}>
                      <p class="editorial-index achievement-row__index">
                        {String(index + 1).padStart(2, "0")}
                      </p>
                      <div class="achievement-row__body">
                        <div class="achievement-row__heading">
                          <h3>{entry.data.title}</h3>
                          {date && isoDate && (
                            <time datetime={isoDate}>{date}</time>
                          )}
                        </div>
                        <p class="achievement-row__summary">
                          {entry.data.summary}
                        </p>
                        <div class="prose">
                          <Content />
                        </div>
                      </div>
                      {entry.data.featured && (
                        <p class="achievement-row__tag">Featured</p>
                      )}
                    </article>
                  );
                })}
              </div>
            ) : (
              <p class="empty-state">
                No achievements have been published yet. This record will be
                updated when the lab shares one.
              </p>
            )
          }
        </section>

        <section
          class="editorial-section achievements-close"
          aria-labelledby="close-title"
        >
          <p class="editorial-kicker">Keep exploring</p>
          <h2 id="close-title">Start with the questions behind the work.</h2>
          <div class="achievements-links">
            <a class="editorial-link" href={withBase("/research/")}
              >Research themes <span aria-hidden="true">→</span></a
            >
            <a class="editorial-link" href={withBase("/pathogens/")}
              >Pathogens <span aria-hidden="true">→</span></a
            >
            <a class="editorial-link" href={withBase("/join/")}
              >Join or collaborate <span aria-hidden="true">→</span></a
            >
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .achievements-page {
    --c-rule: var(--editorial-line, #c9ccc2);
    --c-muted: var(--editorial-muted, #64736f);
    --c-teal: var(--editorial-teal, #276d6a);
  }

  .achievements-page .editorial-hero__intro {
    max-width: 39rem;
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
    column-gap: clamp(1.5rem, 5vw, 5rem);
    align-items: start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--c-rule, var(--line));
  }

  .section-intro .editorial-index {
    grid-row: span 2;
  }

  .section-intro h2 {
    max-width: 25rem;
    margin-bottom: 0.65rem;
  }

  .section-intro p:last-child {
    max-width: 34rem;
    margin-bottom: 0;
    color: var(--c-muted, var(--ink-muted));
  }

  .achievement-row {
    display: grid;
    grid-template-columns: minmax(4rem, 0.45fr) minmax(0, 1fr) auto;
    gap: clamp(1rem, 4vw, 4rem);
    padding-block: 2.2rem;
    border-bottom: 1px solid var(--c-rule, var(--line));
  }

  .achievement-row__index {
    padding-top: 0.3rem;
  }

  .achievement-row__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.25rem;
  }

  .achievement-row h3 {
    margin: 0;
  }

  .achievement-row time,
  .achievement-row__tag {
    color: var(--c-teal, var(--teal-deep));
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .achievement-row__summary {
    max-width: 40rem;
    margin: 0.8rem 0 0;
    color: var(--c-muted, var(--ink-muted));
  }

  .achievement-row .prose {
    max-width: 42rem;
    margin-top: 1rem;
  }

  .achievement-row__tag {
    align-self: start;
    margin: 0;
    white-space: nowrap;
  }

  .achievements-close {
    max-width: 52rem;
    margin-top: 1rem;
    padding-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--c-rule, var(--line));
  }

  .achievements-close h2 {
    max-width: 28rem;
    margin-top: 0.7rem;
  }

  .achievements-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
  }

  .editorial-link {
    color: var(--c-teal, var(--teal-deep));
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 48rem) {
    .section-intro,
    .achievement-row {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .section-intro .editorial-index {
      grid-row: auto;
    }

    .achievement-row__tag {
      justify-self: start;
    }
  }
</style>
