---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { asText, withBase } from "../../components/content";
import updates from "../../data/updates.json";
import site from "../../data/site.json";

const siteName = asText(site.shortName ?? site.name, "Research Lab");
const entries = (await getCollection("achievements")).sort((a, b) => {
  const aDate = a.data.date instanceof Date ? a.data.date.getTime() : 0;
  const bDate = b.data.date instanceof Date ? b.data.date.getTime() : 0;
  return bDate - aDate || a.data.title.localeCompare(b.data.title) || a.id.localeCompare(b.id);
});
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    hasBody: Boolean(entry.body?.trim()),
  })),
);

function dateParts(value: unknown): { label: string; iso: string } | undefined {
  if (!(value instanceof Date) || Number.isNaN(value.getTime())) return undefined;
  return {
    label: new Intl.DateTimeFormat("en", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    }).format(value),
    iso: value.toISOString().slice(0, 10),
  };
}
---

<BaseLayout
  title="Recognition"
  description={`Recognition shared by ${siteName}.`}
>
  <div class="editorial-canvas recognition-page">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>Recognition <span aria-hidden="true">/</span> {siteName}</p>
        <p>Recognition</p>
      </div>

      <div class="editorial-content">
        <header class="editorial-hero" aria-labelledby="recognition-title">
          <h1 id="recognition-title">Recognition</h1>
        </header>

        <section class="editorial-section" aria-label="Recognition">

          {
            rendered.length ? (
              <div class="recognition-list">
                {rendered.map(({ entry, Content, hasBody }, index) => {
                  const title = asText(entry.data.title, "Recognition");
                  const summary = asText(entry.data.summary);
                  const date = dateParts(entry.data.date);
                  return (
                    <article class="recognition-row" id={entry.id}>
                      <p class="recognition-row__index">
                        {String(index + 1).padStart(2, "0")}
                      </p>
                      <div class="recognition-row__body">
                        <div class="recognition-row__heading">
                          <h2>{title}</h2>
                          {date && <time datetime={date.iso}>{date.label}</time>}
                        </div>
                        {summary && <p class="recognition-row__summary">{summary}</p>}
                        {hasBody && <div class="prose"><Content /></div>}
                      </div>
                      {entry.data.featured && (
                        <p class="recognition-row__tag">Featured</p>
                      )}
                    </article>
                  );
                })}
              </div>
            ) : (
              <p class="empty-state">{updates.recognition.emptyState}</p>
            )
          }
        </section>

        <nav class="recognition-links" aria-label="Explore related pages">
          <a class="editorial-link" href={withBase("/research/")}
            >Research themes <span aria-hidden="true">→</span></a
          >
          <a class="editorial-link" href={withBase("/publications/")}
            >Publications <span aria-hidden="true">→</span></a
          >
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .recognition-page {
    --c-rule: var(--editorial-line, #c9ccc2);
    --c-muted: var(--editorial-muted, #64736f);
    --c-teal: var(--editorial-teal, #276d6a);
  }
  .recognition-page .editorial-hero {
    display: block;
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .recognition-page .editorial-section {
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  .recognition-list {
    display: grid;
  }

  .recognition-row {
    display: grid;
    grid-template-columns: minmax(4rem, 0.45fr) minmax(0, 1fr) auto;
    gap: clamp(1rem, 4vw, 4rem);
    padding-block: 2.2rem;
    border-bottom: 1px solid var(--c-rule, var(--line));
  }

  .recognition-row__index {
    margin: 0;
    padding-top: 0.3rem;
    color: var(--c-teal, var(--teal-deep));
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .recognition-row__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.25rem;
  }

  .recognition-row h2 {
    margin: 0;
  }

  .recognition-row time,
  .recognition-row__tag {
    color: var(--c-teal, var(--teal-deep));
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .recognition-row__summary {
    max-width: 40rem;
    margin: 0.8rem 0 0;
    color: var(--c-muted, var(--ink-muted));
  }

  .recognition-row .prose {
    max-width: 42rem;
    margin-top: 1rem;
    line-height: 1.65;
  }

  .recognition-row .prose :global(p) {
    margin-bottom: 0.8rem;
  }

  .recognition-row .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .recognition-row .prose :global(a) {
    color: var(--c-teal, var(--teal-deep));
  }

  .recognition-row__tag {
    align-self: start;
    margin: 0;
    white-space: nowrap;
  }


  .empty-state {
    padding: 1rem 0;
    border-bottom: 1px dashed var(--c-rule, var(--line));
    color: var(--c-muted, var(--ink-muted));
  }

  .recognition-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .editorial-link {
    color: var(--c-teal, var(--teal-deep));
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 48rem) {
    .recognition-row {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .recognition-row__tag {
      justify-self: start;
    }
  }
</style>
