---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { imageAlt, imageSrc, withBase } from "../components/content";
import site from "../data/site.json";

const research = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const news = (await getCollection("news")).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
);
const featuredResearch = research.slice(0, 4).map((entry, index) => ({
  ...entry,
  number: String(index + 1).padStart(2, "0"),
  image: imageSrc(entry.data.image),
  alt: imageAlt(
    entry.data.image,
    `Abstract illustration for ${entry.data.title}`,
  ),
  href: withBase(`/research/#${entry.id}`),
}));
const latestNews = news.slice(0, 3).map((entry) => ({
  ...entry,
  date: entry.data.date.toISOString().slice(0, 10),
  image: imageSrc(entry.data.image),
  alt: imageAlt(entry.data.image, entry.data.title),
  href: withBase(`/news/${entry.id}/`),
}));
const researchHref = withBase("/research/");
const pathogensHref = withBase("/pathogens/");
const newsHref = withBase("/news/");
const contactHref = withBase("/contact/");
---

<BaseLayout title={site.name} description={site.description}>
  <div class="editorial-canvas">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>
          {site.shortName}
          <span aria-hidden="true">/</span> Laboratory overview
        </p>
        <p>Infectious disease research</p>
      </div>

      <div class="editorial-content">
        <header class="editorial-hero home-hero" aria-labelledby="hero-title">
          <div class="home-hero__meta">
            <p class="editorial-kicker">
              {[site.university, site.location].filter(Boolean).join(" · ")}
            </p>
            <p class="home-hero__edition">Laboratory focus / Diagnostics</p>
          </div>
          <div class="home-hero__copy">
            <h1 id="hero-title">
              Understanding infection. <em>Improving diagnosis.</em>
            </h1>
            <p class="home-hero__intro">{site.tagline}</p>
            <p>{site.description}</p>
            <div class="home-hero__actions">
              <a class="editorial-link" href={researchHref}
                >Explore our themes <span aria-hidden="true">↗</span></a
              >
              <a class="editorial-link" href={pathogensHref}
                >Pathogens of interest <span aria-hidden="true">↗</span></a
              >
              <a class="editorial-button" href={contactHref}
                >Start a conversation <span aria-hidden="true">↗</span></a
              >
            </div>
          </div>
          <aside class="home-hero__aside" aria-label="Laboratory note">
            <div class="home-hero__aside-rule" aria-hidden="true"></div>
            <p class="home-hero__aside-label">Methods in practice</p>
            <p>
              Clinical microbiology, molecular biology, molecular epidemiology,
              genomics, and bioinformatics.
            </p>
          </aside>
        </header>

        <section
          class="editorial-section home-research"
          aria-labelledby="research-title"
        >
          <div class="home-section-heading">
            <p class="editorial-index">
              01 <span aria-hidden="true">/</span> Research
            </p>
            <h2 id="research-title">Research at a glance</h2>
            <p>
              Four research themes connect pathogen biology, antimicrobial
              resistance, and rapid diagnostic development.
            </p>
          </div>
          {
            featuredResearch.length ? (
              <div class="editorial-rule-list home-research__list">
                {featuredResearch.map((entry) => (
                  <article class="home-research__row">
                    <p class="editorial-index home-research__number">
                      {entry.number}
                    </p>
                    {entry.image && (
                      <div class="home-research__image-wrap">
                        <img
                          class="home-research__image"
                          src={entry.image}
                          alt={entry.alt}
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="home-research__body">
                      <h3>{entry.data.title}</h3>
                      <p>{entry.data.summary}</p>
                      <a class="editorial-link" href={entry.href}>
                        Explore theme <span aria-hidden="true">↗</span>
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <p class="empty-state">Research themes will appear here soon.</p>
            )
          }
          <a class="editorial-link home-research__archive" href={researchHref}
            >See all research themes <span aria-hidden="true">↗</span></a
          >
        </section>

        <section
          class="editorial-section home-dispatch"
          aria-labelledby="dispatch-title"
        >
          <div class="home-dispatch__label">
            <p class="editorial-index">
              02 <span aria-hidden="true">/</span> Updates
            </p>
            <p class="home-dispatch__date">Lab news and notes</p>
          </div>
          <div class="home-dispatch__body">
            <h2 id="dispatch-title">Updates from the laboratory</h2>
            <p>
              Follow the lab’s latest news and updates on infectious disease
              research, bacterial pathogens, and diagnostic technologies.
            </p>
            {
              latestNews.length ? (
                <div class="home-news-list">
                  {latestNews.map((entry) => (
                    <article
                      class:list={[
                        "home-news-row",
                        entry.image
                          ? "home-news-row--with-image"
                          : "home-news-row--no-image",
                      ]}
                    >
                      {entry.image && (
                        <img
                          class="home-news-row__image"
                          src={entry.image}
                          alt={entry.alt}
                          loading="lazy"
                        />
                      )}
                      <div>
                        <time datetime={entry.date}>{entry.date}</time>
                        <h3>
                          <a href={entry.href}>{entry.data.title}</a>
                        </h3>
                        <p>{entry.data.summary}</p>
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <p class="empty-state">News and notes will appear here soon.</p>
              )
            }
            <a class="editorial-link" href={newsHref}
              >Read the latest updates <span aria-hidden="true">↗</span></a
            >
          </div>
        </section>

        <section
          class="editorial-section home-close"
          aria-labelledby="join-title"
        >
          <div>
            <p class="editorial-kicker">Enquiries and collaboration</p>
            <h2 id="join-title">Continue the conversation.</h2>
          </div>
          <div class="home-close__body">
            <p>{site.joinText}</p>
            <a class="editorial-button" href={contactHref}
              >Contact the lab <span aria-hidden="true">↗</span></a
            >
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(7rem, 0.55fr) minmax(0, 2fr) minmax(
        10rem,
        0.8fr
      );
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding-block: clamp(3.5rem, 8vw, 7rem);
    border-bottom: 1px solid var(--c-rule, var(--line));
  }

  .home-hero__meta,
  .home-hero__aside,
  .home-dispatch__label {
    color: var(--c-muted, var(--ink-muted));
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .home-hero__meta p,
  .home-hero__aside p,
  .home-dispatch__label p {
    margin-bottom: 0;
  }

  .home-hero__edition {
    margin-top: 1.25rem;
  }

  .home-hero__copy h1 {
    max-width: 10ch;
    margin: 0 0 1.4rem;
    color: var(--c-ink, var(--ink));
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.94;
  }

  .home-hero__copy h1 em {
    color: var(--c-teal, var(--teal-deep));
    font-style: normal;
  }

  .home-hero__intro {
    max-width: 32rem;
    margin-bottom: 0.75rem;
    color: var(--c-ink, var(--ink));
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.35rem, 2.5vw, 1.9rem);
    line-height: 1.25;
  }

  .home-hero__copy > p:not(.home-hero__intro) {
    max-width: 38rem;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .home-hero__aside {
    padding-top: 0.25rem;
  }

  .home-hero__aside-rule {
    width: 2.5rem;
    margin-bottom: 1rem;
    border-top: 2px solid var(--c-teal, var(--teal-deep));
  }

  .home-hero__aside-label {
    color: var(--c-ink, var(--ink));
    font-weight: 700;
  }

  .home-hero__aside p:last-child {
    margin-top: 0.85rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.05rem;
    letter-spacing: 0;
    line-height: 1.45;
    text-transform: none;
  }

  .home-research {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .home-section-heading {
    display: grid;
    grid-template-columns: minmax(7rem, 0.55fr) minmax(0, 1.4fr) minmax(
        11rem,
        0.8fr
      );
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: 2.5rem;
  }

  .home-section-heading > * {
    margin-bottom: 0;
  }

  .home-section-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .home-section-heading > p:last-child {
    font-size: 0.95rem;
  }

  .home-research__row {
    display: grid;
    grid-template-columns: minmax(4rem, 0.55fr) minmax(9rem, 0.75fr) minmax(
        0,
        2fr
      );
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: center;
    padding-block: 1.4rem;
  }

  .home-research__number {
    align-self: start;
    margin: 0;
    padding-top: 0.25rem;
  }

  .home-research__image-wrap {
    aspect-ratio: 1;
    background: var(--c-soft-teal, var(--mint-soft));
  }

  .home-research__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-research__body h3 {
    margin-bottom: 0.45rem;
  }

  .home-research__body p {
    max-width: 36rem;
    margin-bottom: 0.85rem;
  }

  .home-research__archive {
    margin-top: 1.25rem;
  }

  .empty-state {
    padding: 1.2rem;
    border: 1px dashed var(--c-rule, var(--line));
    color: var(--c-muted, var(--ink-muted));
  }

  .home-dispatch {
    display: grid;
    grid-template-columns: minmax(7rem, 0.55fr) minmax(0, 2.8fr);
    gap: clamp(1.5rem, 8vw, 8rem);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    border-top: 1px solid var(--c-rule, var(--line));
  }

  .home-dispatch__date {
    margin-top: 1rem;
  }

  .home-dispatch__body h2 {
    max-width: 14ch;
    margin-bottom: 1rem;
  }

  .home-dispatch__body > p {
    max-width: 40rem;
  }

  .home-news-list {
    margin-block: 2rem;
    border-top: 1px solid var(--c-rule, var(--line));
  }

  .home-news-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--c-rule, var(--line));
  }

  .home-news-row--with-image {
    grid-template-columns: 5.5rem minmax(0, 1fr);
  }

  .home-news-row__image {
    width: 5.5rem;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .home-news-row time {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--c-muted, var(--ink-muted));
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-news-row h3 {
    margin-bottom: 0.3rem;
    font-size: 1.3rem;
  }

  .home-news-row h3 a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .home-news-row p {
    margin-bottom: 0;
    font-size: 0.95rem;
  }

  .home-close {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(12rem, 1fr);
    gap: clamp(2rem, 8vw, 8rem);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    border-top: 1px solid var(--c-rule, var(--line));
  }

  .home-close h2 {
    margin: 0.45rem 0 0;
    font-size: clamp(2.1rem, 4vw, 3.8rem);
  }

  .home-close__body p {
    max-width: 32rem;
  }

  @media (max-width: 48rem) {
    .home-hero,
    .home-section-heading,
    .home-research__row,
    .home-dispatch,
    .home-close {
      grid-template-columns: 1fr;
    }

    .home-hero__meta,
    .home-hero__aside,
    .home-dispatch__label {
      max-width: 34rem;
    }

    .home-hero__aside {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      column-gap: 1rem;
      align-items: start;
    }

    .home-hero__aside-rule {
      grid-row: span 2;
      margin-top: 0.45rem;
      margin-bottom: 0;
    }

    .home-hero__aside p:last-child {
      margin-top: 0.35rem;
    }

    .home-research__row {
      grid-template-columns: 3rem minmax(0, 1fr);
      align-items: start;
    }

    .home-research__image-wrap {
      grid-column: 2;
      grid-row: 1;
      max-width: 10rem;
    }

    .home-research__body {
      grid-column: 2;
    }

    .home-research__number {
      grid-column: 1;
      grid-row: 1;
    }

    .home-dispatch__body,
    .home-close__body {
      max-width: 42rem;
    }
  }

  @media (max-width: 38rem) {
    .home-hero {
      padding-top: 2.5rem;
    }

    .home-news-row--with-image {
      grid-template-columns: 4.25rem minmax(0, 1fr);
    }

    .home-news-row__image {
      width: 4.25rem;
    }
  }
</style>
