---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { imageSrc, withBase } from "../components/content";
import site from "../data/site.json";
import home from "../data/home.json";

const overviewImages: {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}[] = home.images;

const research = (await getCollection("research"))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
---

<BaseLayout title={site.name} description={site.description}>
  <div class="editorial-canvas home-page">
    <div class="editorial-sheet">
      <header class="home-titlebar">
        <div>
          <p class="editorial-kicker">{site.university}</p>
          <h1>{site.name}</h1>
          <p class="home-tagline">{site.tagline}</p>
        </div>
        <p class="home-location">{site.location}</p>
      </header>

      <div class="editorial-content">
        <section class="home-overview" aria-labelledby="overview-title">
          <div class="home-section-heading">
            <p class="editorial-index">01 / {home.overviewLabel}</p>
            <h2 id="overview-title">{home.overviewTitle}</h2>
          </div>
          <div class="overview-grid">
            {
              overviewImages.length > 0 && (
                <div
                  class="overview-images"
                  role="group"
                  aria-label="Laboratory workflows"
                >
                  {overviewImages.map((image) => (
                    <figure>
                      <img
                        src={imageSrc(image)}
                        alt={image.alt}
                        width={image.width}
                        height={image.height}
                        loading="lazy"
                        decoding="async"
                      />
                      {image.caption && (
                        <figcaption>{image.caption}</figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              )
            }
            <div class="overview-copy">
              {site.about.map((paragraph) => <p>{paragraph}</p>)}
              <a class="editorial-link" href={withBase("/people/")}>
                {home.teamLinkLabel}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </section>

        <section class="home-research" aria-labelledby="research-title">
          <div class="home-section-heading">
            <p class="editorial-index">02 / Research</p>
            <h2 id="research-title">{home.researchTitle}</h2>
          </div>
          <div class="research-grid">
            {
              research.map((entry, index) => (
                <article>
                  <span class="theme-number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3>
                      <a href={withBase(`/research/#${entry.id}`)}>
                        {entry.data.title}
                      </a>
                    </h3>
                    <p>{entry.data.summary}</p>
                  </div>
                </article>
              ))
            }
          </div>
          <a class="editorial-link research-more" href={withBase("/research/")}>
            {home.researchLinkLabel}
            <span aria-hidden="true">↗</span>
          </a>
        </section>

        <section class="home-contact" aria-labelledby="contact-title">
          <div>
            <p class="editorial-index">03 / Get in touch</p>
            <h2 id="contact-title">{home.contactTitle}</h2>
          </div>
          <div class="contact-copy">
            <p>{site.joinText}</p>
            <p class="contact-affiliation">
              {site.university}<br />{site.address.join(", ")}
            </p>
            {
              site.email && (
                <p>
                  <a href={`mailto:${site.email}`}>{site.email}</a>
                </p>
              )
            }
            {
              site.phone && (
                <p>
                  <a href={`tel:${site.phone.replace(/[^+\d]/g, "")}`}>
                    {site.phone}
                  </a>
                </p>
              )
            }
            <a class="editorial-button" href={withBase("/contact/")}>
              {home.contactLinkLabel}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .home-titlebar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 5vw, 4.5rem) 2rem;
    border-top: 4px solid var(--teal);
    border-bottom: 1px solid var(--line);
  }
  .home-titlebar h1 {
    max-width: none;
    margin: 0.85rem 0 0.7rem;
    font-size: clamp(2.7rem, 5vw, 4.5rem);
  }
  .home-titlebar .editorial-kicker {
    max-width: 43rem;
  }
  .home-tagline {
    margin: 0;
    font-size: 1rem;
  }
  .home-location {
    flex-shrink: 0;
    margin: 0 0 0.2rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .home-overview,
  .home-research,
  .home-contact {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .home-overview,
  .home-research {
    border-bottom: 1px solid var(--line);
  }
  .home-section-heading {
    margin-bottom: 2rem;
  }
  .home-section-heading h2 {
    margin: 0.65rem 0 0;
  }
  .overview-grid {
    display: flex;
    align-items: flex-start;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .overview-images {
    display: grid;
    gap: 1.1rem;
    flex: 0 0 34%;
  }
  figure {
    margin: 0;
  }
  .overview-images img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  figcaption {
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
  }
  .overview-copy {
    flex: 1;
    min-width: 0;
    max-width: 47rem;
  }
  .overview-copy > p {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.8;
    margin-bottom: 1.2rem;
  }
  .overview-copy > p:first-child {
    color: var(--navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    line-height: 1.5;
  }
  .overview-copy .editorial-link {
    margin-top: 0.6rem;
  }
  .research-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 3rem;
  }
  .research-grid article {
    display: flex;
    gap: 1.2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .theme-number {
    padding-top: 0.2rem;
    font-size: 0.7rem;
    color: var(--teal);
  }
  .research-grid h3 {
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0 0 0.8rem;
  }
  .research-grid h3 a {
    text-decoration: none;
    color: inherit;
  }
  .research-grid h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .research-grid p {
    font-size: 0.95rem;
    margin: 0;
  }
  .research-more {
    margin-top: 1.5rem;
  }
  .home-contact {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem;
  }
  .home-contact h2 {
    margin-top: 0.65rem;
  }
  .contact-copy {
    max-width: 39rem;
  }
  .contact-affiliation {
    font-size: 0.9rem;
  }
  @media (max-width: 52rem) {
    .home-titlebar {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
    .overview-grid {
      gap: 2rem;
    }
    .overview-images {
      flex-basis: 34%;
    }
  }
  @media (max-width: 38rem) {
    .overview-grid {
      flex-direction: column-reverse;
    }
    .overview-images {
      width: 100%;
      gap: 1.25rem;
    }
    .research-grid,
    .home-contact {
      grid-template-columns: 1fr;
    }
    .home-contact {
      gap: 0.5rem;
    }
    .home-contact h2 {
      margin-bottom: 1rem;
    }
  }
</style>
