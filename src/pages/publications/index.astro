---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationItem from "../../components/PublicationItem.astro";
import publicationPage from "../../data/publications.json";

const publications = (await getCollection("publications")).sort(
  (a, b) =>
    b.data.year - a.data.year ||
    // Entries without an order sort after explicitly ordered records.
    (a.data.order ?? Number.MAX_SAFE_INTEGER) -
      (b.data.order ?? Number.MAX_SAFE_INTEGER),
);
const years = [...new Set(publications.map((entry) => entry.data.year))];
---

<BaseLayout
  title={publicationPage.title}
  description={publicationPage.intro}
>
  <div class="editorial-canvas publications-page">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>Research record <span aria-hidden="true">/</span> Publications</p>
        <p>{publications.length} works</p>
      </div>

      <div class="editorial-content">
        <header class="publications-hero" aria-labelledby="publications-title">
          <div class="publications-hero__meta">
            <p class="editorial-kicker">Publications</p>
            <p class="publications-hero__edition">A working bibliography</p>
          </div>
          <div class="publications-hero__copy">
            <h1 id="publications-title">{publicationPage.title}</h1>
            <p>{publicationPage.intro}</p>
          </div>
        </header>

        {
          publications.length ? (
            <div class="publication-archive" aria-label="Publications by year">
              {years.map((year) => (
                <section class="publication-year" aria-labelledby={`year-${year}`}>
                  <div class="publication-year__heading">
                    <h2 id={`year-${year}`}>{year}</h2>
                    <p>
                      {publications.filter((entry) => entry.data.year === year).length} {" "}
                      {publications.filter((entry) => entry.data.year === year).length === 1
                        ? "publication"
                        : "publications"}
                    </p>
                  </div>
                  <div class="publication-year__items">
                    {publications
                      .filter((entry) => entry.data.year === year)
                      .map((entry) => <PublicationItem entry={entry} />)}
                  </div>
                </section>
              ))}
            </div>
          ) : (
            <p class="empty-state">Publication records have not yet been added.</p>
          )
        }

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .publications-page {
    --editorial-ink: var(--ink);
    --editorial-navy: var(--navy);
    --editorial-teal: var(--teal);
    --editorial-ivory: var(--canvas);
    --editorial-paper: var(--paper);
    --editorial-line: var(--line);
    --editorial-muted: var(--muted);
    color: var(--editorial-ink);
    background: var(--editorial-ivory);
  }

  .publications-hero {
    display: grid;
    grid-template-columns: minmax(8rem, 0.65fr) minmax(0, 2.9fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: start;
    padding-block: clamp(3.75rem, 8vw, 6.75rem);
    border-bottom: 1px solid var(--editorial-line);
  }

  .publications-hero__meta {
    padding-top: 0.35rem;
  }

  .publications-hero__edition {
    margin-top: 1.4rem;
    color: var(--editorial-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.45;
    text-transform: uppercase;
  }


  .publications-hero h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--editorial-navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.8rem, 6vw, 5.25rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .publications-hero__copy > p {
    max-width: 37rem;
    margin: 1.6rem 0 0;
    color: var(--editorial-muted);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.08rem, 1.8vw, 1.3rem);
    line-height: 1.45;
  }

  .publication-archive {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .publication-year + .publication-year {
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .publication-year__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 2px solid var(--editorial-navy);
  }

  .publication-year__heading h2 {
    margin: 0;
    color: var(--editorial-navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .publication-year__heading p {
    margin: 0;
    color: var(--editorial-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .publication-year__items {
    border-bottom: 1px solid var(--editorial-line);
  }

  .publication-year__items :global(.publication-item) {
    border-top: 1px solid var(--editorial-line);
    padding-block: 1.35rem;
  }

  .publication-year__items :global(.publication-item:first-child) {
    border-top: 0;
  }

  .publication-year__items :global(.publication-item__body) {
    gap: 0.42rem;
  }

  .publication-year__items :global(.publication-item h3) {
    color: var(--editorial-navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 400;
    line-height: 1.22;
  }

  .publication-year__items :global(.publication-item h3 a:hover),
  .publication-year__items :global(.publication-item h3 a:focus-visible) {
    color: var(--editorial-teal);
  }

  .publication-year__items :global(.publication-item p) {
    margin: 0;
  }

  .publication-year__items :global(.publication-item__authors) {
    color: var(--editorial-ink);
    font-size: 0.88rem;
  }

  .publication-year__items :global(.publication-item__journal) {
    color: var(--editorial-muted);
    font-size: 0.78rem;
    font-style: italic;
  }

  .publication-year__items :global(.publication-item .text-link) {
    width: fit-content;
    margin-top: 0.25rem;
    color: var(--editorial-teal);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.69rem;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .empty-state {
    padding: 1.2rem 0;
    border-block: 1px dashed var(--editorial-line);
    color: var(--editorial-muted);
  }


  @media (max-width: 48rem) {
    .publications-hero {
      grid-template-columns: minmax(6rem, 0.45fr) minmax(0, 1.55fr);
    }

  }

  @media (max-width: 38rem) {
    .publications-hero {
      display: block;
    }

    .publications-hero__copy {
      margin-top: 1.5rem;
    }


    .publication-year__heading {
      display: block;
    }

    .publication-year__heading p {
      margin-top: 0.4rem;
    }
  }
</style>
