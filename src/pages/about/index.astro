---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { imageSrc, withBase } from "../../components/content";
import site from "../../data/site.json";
import home from "../../data/home.json";

const overviewImages: {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}[] = home.images;

const about = Array.isArray(site.about)
  ? site.about.filter(
      (paragraph): paragraph is string => typeof paragraph === "string",
    )
  : [];

const methods = [
  "Clinical microbiology",
  "Molecular biology",
  "Molecular epidemiology",
  "Genomics",
  "Bioinformatics",
];

const focusAreas = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
---

<BaseLayout title={`About · ${site.shortName}`} description={site.description}>
  <div class="editorial-canvas about-page">
    <div class="editorial-sheet">
      <div class="editorial-bar">
        <p>About <span aria-hidden="true">/</span> {site.shortName}</p>
        <p>Laboratory overview</p>
      </div>

      <div class="editorial-content">
        <header class="editorial-hero about-hero" aria-labelledby="about-title">
          <div class="about-hero__meta">
            <p class="editorial-kicker">The laboratory</p>
            <p class="about-hero__location">
              {site.university} · {site.location}
            </p>
          </div>
          <div class="about-hero__copy">
            <h1 id="about-title">About the lab</h1>
            <p class="editorial-hero__intro">{site.tagline}</p>
          </div>
          <aside class="about-hero__aside" aria-label="Laboratory lead">
            <p class="about-hero__aside-label">Led by</p>
            <p>Dr. Tushar Shaw</p>
          </aside>
        </header>

        <section
          class="editorial-section about-overview"
          aria-labelledby="overview-title"
        >
          <div class="about-section-label">
            <p class="editorial-index">
              01 <span aria-hidden="true">/</span> About the laboratory
            </p>
            <h2 id="overview-title">Infectious disease research</h2>
          </div>
          <div class="about-overview__body">
            {
              overviewImages.length > 0 && (
                <div
                  class="about-overview__images"
                  role="group"
                  aria-label="Laboratory group photographs"
                >
                  {overviewImages.map((image) => (
                    <figure>
                      <img
                        src={imageSrc(image)}
                        alt={image.alt}
                        width={image.width}
                        height={image.height}
                        loading="lazy"
                        decoding="async"
                      />
                      {image.caption && (
                        <figcaption>{image.caption}</figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              )
            }
            <div class="about-overview__copy">
              {about.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </div>
        </section>

        <section
          class="editorial-section about-methods"
          aria-labelledby="methods-title"
        >
          <div class="about-section-label">
            <p class="editorial-index">
              02 <span aria-hidden="true">/</span> Methods
            </p>
          </div>
          <div class="about-methods__body">
            <h2 id="methods-title">Research methods</h2>
            <ul class="about-methods__list">
              {methods.map((method) => <li>{method}</li>)}
            </ul>
          </div>
        </section>

        <section
          class="editorial-section about-focus"
          aria-labelledby="focus-title"
        >
          <div class="about-section-label">
            <p class="editorial-index">
              03 <span aria-hidden="true">/</span> Research at a glance
            </p>
          </div>
          <div class="about-focus__body">
            <h2 id="focus-title">Research areas</h2>
            <div class="about-focus__list">
              {
                focusAreas.map((area, index) => (
                  <article class="about-focus__item">
                    <p class="about-focus__number">
                      {String(index + 1).padStart(2, "0")}
                    </p>
                    <div>
                      <h3>
                        <a href={withBase(`/research/#${area.id}`)}>
                          {area.data.title}
                        </a>
                      </h3>
                      <p>{area.data.summary}</p>
                    </div>
                  </article>
                ))
              }
            </div>
            <a class="editorial-link" href={withBase("/research/")}
              >Explore research themes <span aria-hidden="true">↗</span></a
            >
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    --about-rule: var(--editorial-line, var(--line));
    --about-muted: var(--editorial-muted, var(--muted));
    --about-teal: var(--editorial-teal, var(--teal));
    color: var(--ink);
    background: var(--canvas);
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(8rem, 0.65fr) minmax(0, 2.1fr) minmax(
        10rem,
        0.75fr
      );
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: start;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--about-rule);
  }

  .about-hero__location,
  .about-hero__aside-label {
    margin-top: 1.4rem;
    color: var(--about-muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .about-hero__copy h1 {
    max-width: 15ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2.75rem, 6vw, 5.7rem);
    line-height: 0.96;
  }

  .about-hero__copy .editorial-hero__intro {
    max-width: 32rem;
  }

  .about-hero__aside {
    padding-top: 0.8rem;
    border-top: 1px solid var(--about-teal);
  }

  .about-hero__aside-label {
    margin: 0 0 0.35rem;
    color: var(--about-teal);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .about-hero__aside p:last-child {
    margin-bottom: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.15rem;
  }

  .about-overview,
  .about-methods,
  .about-focus {
    display: grid;
    grid-template-columns: minmax(8rem, 0.65fr) minmax(0, 2.1fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-bottom: 1px solid var(--about-rule);
  }

  .about-overview {
    display: block;
  }

  .about-overview .about-section-label {
    max-width: none;
    margin-bottom: 2rem;
  }

  .about-overview .about-section-label h2 {
    max-width: none;
    margin-bottom: 0;
  }

  .about-overview__body {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .about-overview__body,
  .about-methods__body,
  .about-focus__body {
    min-width: 0;
  }

  .about-overview h2,
  .about-methods h2,
  .about-focus h2 {
    max-width: 18ch;
    margin-bottom: 1.5rem;
    font-size: clamp(1.9rem, 3.5vw, 3rem);
  }

  .about-overview__body p {
    max-width: 44rem;
  }

  .about-overview__images {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .about-overview__images figure {
    margin: 0;
  }

  .about-overview__images img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--about-rule);
  }

  .about-overview__images figcaption {
    margin-top: 0.45rem;
    color: var(--about-muted);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
  }

  .about-methods__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--about-rule);
  }

  .about-methods__list li {
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--about-rule);
    color: var(--about-teal);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.15rem;
  }

  .about-focus {
    border-bottom: 0;
  }

  .about-focus__list {
    margin-bottom: 1.5rem;
    border-top: 1px solid var(--about-rule);
  }

  .about-focus__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--about-rule);
  }

  .about-focus__number {
    margin: 0;
    color: var(--about-teal);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .about-focus__item h3 {
    margin-bottom: 0.4rem;
  }

  .about-focus__item h3 a {
    color: inherit;
    text-decoration: none;
  }

  .about-focus__item h3 a:hover,
  .about-focus__item h3 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .about-focus__item p:last-child {
    max-width: 40rem;
    margin-bottom: 0;
    color: var(--about-muted);
  }

  @media (max-width: 48rem) {
    .about-hero,
    .about-overview,
    .about-methods,
    .about-focus {
      grid-template-columns: 1fr;
    }

    .about-hero__meta,
    .about-hero__aside,
    .about-section-label {
      max-width: 34rem;
    }

    .about-hero__aside {
      padding-top: 0.75rem;
    }
  }

  @media (max-width: 38rem) {
    .about-hero__copy h1 {
      font-size: clamp(1.9rem, 8vw, 2.2rem);
      line-height: 1.1;
    }

    .about-overview h2,
    .about-methods h2,
    .about-focus h2 {
      font-size: 1.5rem;
    }

    .about-focus__item h3 {
      font-size: 1.25rem;
    }

    .about-overview__body {
      grid-template-columns: 1fr;
    }

    .about-methods__list {
      grid-template-columns: 1fr;
    }

    .about-hero {
      padding-top: 2.5rem;
    }
  }
</style>
