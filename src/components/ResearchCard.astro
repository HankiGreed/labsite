---
import { asText, type EntryLike, valueOf } from "./content";

interface Props {
  entry: EntryLike;
}

const { entry } = Astro.props;
const title = asText(valueOf(entry, "title"), "Research area");
const summary = asText(valueOf(entry, "summary"));
const panelId = `research-${entry.id ?? entry.slug}-body`;
---

<article id={entry.id ?? entry.slug} class="research-card">
  <span class="research-card__number" aria-hidden="true">
    <slot name="number" />
  </span>
  <h2 class="research-card__heading">
    <button
      type="button"
      class="research-card__title"
      aria-expanded="false"
      aria-controls={panelId}
    >
      <span>{title}</span>
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M6 9l6 6 6-6"
          stroke="currentColor"
          fill="none"
          stroke-width="2"></path>
      </svg>
    </button>
  </h2>
  <p class="research-card__excerpt">{summary}</p>
  <div id={panelId} class="research-card__prose prose" hidden>
    <slot />
  </div>
</article>

<script>
  function initializeResearchCards() {
    document
      .querySelectorAll<HTMLButtonElement>(".research-card__title")
      .forEach((button) => {
        if (button.dataset.initialized) return;
        const panel = document.getElementById(
          button.getAttribute("aria-controls") ?? "",
        );
        if (!panel) return;
        button.dataset.initialized = "true";
        button.addEventListener("click", () => {
          const expanded = button.getAttribute("aria-expanded") !== "true";
          button.setAttribute("aria-expanded", String(expanded));
          panel.hidden = !expanded;
        });
      });
  }

  initializeResearchCards();
  document.addEventListener("astro:page-load", initializeResearchCards);
</script>

<style>
  .research-card {
    min-width: 0;
    scroll-margin-top: 6rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line);
  }

  .research-card:target {
    border-bottom-color: var(--teal);
  }

  .research-card__heading {
    margin: 0.75rem 0;
  }

  .research-card__title:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 0.25rem;
  }

  .research-card__number {
    color: var(--teal);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .research-card__title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
    color: var(--navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .research-card__title:hover {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .research-card__excerpt,
  .research-card__prose {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .research-card__excerpt {
    margin: 0;
  }

  .research-card__title svg {
    flex-shrink: 0;
    transition: transform 160ms ease;
  }

  .research-card__title[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .research-card__title svg {
      transition: none;
    }
  }

  .research-card__prose {
    margin-top: 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .research-card__prose :global(p) {
    margin: 0;
  }

  .research-card__prose :global(p + p) {
    margin-top: 0.8rem;
  }
</style>
