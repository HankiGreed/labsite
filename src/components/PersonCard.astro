---
import {
  asText,
  imageAlt,
  imageSrc,
  isExternal,
  type EntryLike,
  valueOf,
  withBase,
} from "./content";

interface Props {
  entry: EntryLike;
}

const { entry } = Astro.props;
const name = asText(valueOf(entry, "name", "fullName", "title"), "Researcher");
const role = asText(valueOf(entry, "role", "position", "title"));
const bio = asText(valueOf(entry, "bio", "description", "summary"));
const image = valueOf(entry, "image", "photo", "portrait");
const textOnly = ["students", "alumni"].includes(
  asText(valueOf(entry, "group")),
);
const imageUrl = textOnly ? "" : imageSrc(image);
const linkValue = asText(valueOf(entry, "link", "profile", "website", "url"));
const email = asText(valueOf(entry, "email"));
const link = linkValue
  ? isExternal(linkValue)
    ? linkValue
    : withBase(linkValue)
  : "";
---

<article class:list={["person-card", { "person-card--text-only": !imageUrl }]}>
  <header class="person-card__header">
    <h3>{name}</h3>
    {role && <p class="person-card__role">{role}</p>}
  </header>
  {
    imageUrl && (
      <img
        class="person-card__image"
        src={imageUrl}
        alt={imageAlt(image, name)}
        loading="lazy"
      />
    )
  }
  <div class="person-card__body">
    {bio && <p>{bio}</p>}
    {
      Astro.slots.has("default") && (
        <div class="person-card__prose prose">
          <slot />
        </div>
      )
    }
    {
      (email || link) && (
        <div class="person-card__links">
          {email && <a href={`mailto:${email}`}>Email</a>}
          {link && (
            <a
              href={link}
              target={
                isExternal(linkValue) && !link.startsWith("mailto:")
                  ? "_blank"
                  : undefined
              }
              rel={
                isExternal(linkValue) && !link.startsWith("mailto:")
                  ? "noreferrer"
                  : undefined
              }
            >
              Profile <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .person-card {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    align-items: start;
    padding: 1.35rem 0;
    border-top: 1px solid var(--line);
  }

  .person-card__header {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.4rem;
  }

  .person-card__image {
    width: 100%;
    height: auto;
    max-height: 22rem;
    object-fit: contain;
    object-position: left top;
  }

  .person-card--text-only {
    grid-template-columns: minmax(0, 1fr);
  }

  .person-card__body {
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }

  .person-card h3 {
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.2;
    margin-top: 0;
    margin-bottom: 0;
  }

  .person-card p {
    margin-bottom: 0;
  }

  .person-card__role {
    color: var(--teal);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .person-card__prose {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .person-card__prose :global(p) {
    margin: 0 0 0.75rem;
  }

  .person-card__prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .person-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 0.35rem;
  }

  .person-card__links a {
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.05em;
    text-underline-offset: 0.2em;
    text-transform: uppercase;
  }

  @media (max-width: 38rem) {
    .person-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .person-card__image {
      width: min(100%, 11rem);
      max-height: 16rem;
    }

    .person-card h3 {
      font-size: 1.3rem;
    }
  }
</style>
