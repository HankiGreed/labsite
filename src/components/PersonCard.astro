---
import {
  asText,
  imageAlt,
  imageSrc,
  isExternal,
  type EntryLike,
  valueOf,
  withBase,
  initials,
} from "./content";

interface Props {
  entry: EntryLike;
}

const { entry } = Astro.props;
const name = asText(valueOf(entry, "name", "fullName", "title"), "Researcher");
const role = asText(valueOf(entry, "role", "position", "title"));
const bio = asText(valueOf(entry, "bio", "description", "summary"));
const image = valueOf(entry, "image", "photo", "portrait");
const imageUrl = imageSrc(image);
const linkValue = asText(valueOf(entry, "link", "profile", "website", "url"));
const email = asText(valueOf(entry, "email"));
const link = linkValue
  ? isExternal(linkValue)
    ? linkValue
    : withBase(linkValue)
  : "";
---

<article class="person-card">
  {
    imageUrl ? (
      <img
        class="person-card__image"
        src={imageUrl}
        alt={imageAlt(image, name)}
        loading="lazy"
      />
    ) : (
      <div class="person-card__avatar" aria-hidden="true">
        {initials(name)}
      </div>
    )
  }
  <div class="person-card__body">
    <h3>{name}</h3>
    {role && <p class="person-card__role">{role}</p>}
    {bio && <p>{bio}</p>}
    <div class="person-card__links">
      {email && <a href={`mailto:${email}`}>Email</a>}
      {
        link && (
          <a
            href={link}
            target={
              isExternal(linkValue) && !link.startsWith("mailto:")
                ? "_blank"
                : undefined
            }
            rel={
              isExternal(linkValue) && !link.startsWith("mailto:")
                ? "noreferrer"
                : undefined
            }
          >
            Profile <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .person-card {
    display: grid;
    grid-template-columns: minmax(7rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    align-items: start;
    padding: 1.35rem 0;
    border-top: 1px solid var(--line);
  }

  .person-card__image,
  .person-card__avatar {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .person-card__avatar {
    align-items: center;
    display: flex;
    justify-content: center;
    color: var(--teal);
    background: var(--teal-soft);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 5vw, 3.8rem);
  }

  .person-card__body {
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }

  .person-card h3 {
    margin-bottom: 0;
  }

  .person-card p {
    margin-bottom: 0;
  }

  .person-card__role {
    color: var(--teal);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .person-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 0.35rem;
  }

  .person-card__links a {
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.05em;
    text-underline-offset: 0.2em;
    text-transform: uppercase;
  }

  @media (max-width: 38rem) {
    .person-card {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
