---
interface Props {
  eyebrow: string;
  title: string;
  copy?: string;
}

const { eyebrow, title, copy } = Astro.props;
---

<header class="section-heading editorial-section-heading">
  <p class="section-heading__eyebrow editorial-kicker">{eyebrow}</p>
  <h2>{title}</h2>
  {copy && <p class="section-heading__copy">{copy}</p>}
</header>
